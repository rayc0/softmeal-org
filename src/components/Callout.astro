---
/**
 * Callout — clinical/warning/tip alert blocks for article content.
 *
 * Usage:
 *   <Callout variant="clinical">For clinicians: ...</Callout>
 *   <Callout variant="warning">Do not use if ...</Callout>
 *   <Callout variant="tip">Preparation tip: ...</Callout>
 *
 * Variants:
 *   clinical — jade left bar + stethoscope icon; for clinician-directed guidance
 *   warning  — persimmon left bar + cream background + alert icon; for safety notices
 *   tip      — dashed ink-20% border; for practical preparation tips
 */

export interface Props {
  variant?: 'clinical' | 'warning' | 'tip';
  class?: string;
}

const { variant = 'tip', class: className = '' } = Astro.props;
---

{variant === 'clinical' && (
  <aside class:list={['callout-clinical not-prose flex gap-3 my-6 pl-4 border-l-4 border-jade rounded-r-md py-3 pr-4 bg-jade-50', className]}>
    <span class="mt-0.5 shrink-0 text-jade-600" aria-hidden="true">
      <!-- Stethoscope icon -->
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/>
        <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/>
        <circle cx="20" cy="10" r="2"/>
      </svg>
    </span>
    <div class="text-sm leading-relaxed text-jade-900">
      <slot />
    </div>
  </aside>
)}

{variant === 'warning' && (
  <aside class:list={['callout-warning not-prose flex gap-3 my-6 pl-4 border-l-4 border-persimmon rounded-r-md py-3 pr-4 bg-congee-100', className]}>
    <span class="mt-0.5 shrink-0 text-persimmon-600" aria-hidden="true">
      <!-- Alert triangle icon -->
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/>
        <path d="M12 9v4"/>
        <path d="M12 17h.01"/>
      </svg>
    </span>
    <div class="text-sm leading-relaxed text-ink-800">
      <slot />
    </div>
  </aside>
)}

{variant === 'tip' && (
  <aside class:list={['callout-tip not-prose flex gap-3 my-6 border border-dashed border-ink-200 rounded-md py-3 px-4', className]}>
    <span class="mt-0.5 shrink-0 text-ink-400" aria-hidden="true">
      <!-- Lightbulb icon -->
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/>
        <path d="M9 18h6"/>
        <path d="M10 22h4"/>
      </svg>
    </span>
    <div class="text-sm leading-relaxed text-ink-700">
      <slot />
    </div>
  </aside>
)}
