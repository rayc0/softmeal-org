---
interface Props {
  lang: string;
}
const { lang } = Astro.props;

type LangKey = 'zh-hk' | 'zh-cn' | 'ja' | 'en';
const l = (lang as LangKey) in {'zh-hk':1,'zh-cn':1,'ja':1,'en':1} ? lang as LangKey : 'zh-hk';

const headings: Record<LangKey, { brand: string; knowledge: string; tools: string; partners: string }> = {
  'zh-hk': { brand: 'softmeal.org', knowledge: '知識資源', tools: '食譜 & 工具', partners: '相關網站' },
  'zh-cn': { brand: 'softmeal.org', knowledge: '知识资源', tools: '食谱 & 工具', partners: '相关网站' },
  'ja':    { brand: 'softmeal.org', knowledge: '知識リソース', tools: 'レシピ & ツール', partners: '関連サイト' },
  'en':    { brand: 'softmeal.org', knowledge: 'Knowledge', tools: 'Recipes & Tools', partners: 'Related Sites' },
};

const taglines: Record<LangKey, string> = {
  'zh-hk': '香港照護食知識中心。主辦：愛聯社有限公司。專業支援：康樂齡 SeniorDeli。',
  'zh-cn': '香港照护食知识中心。主办：爱联社有限公司。专业支持：康乐龄 SeniorDeli。',
  'ja':    'HK介護食ナレッジセンター。主催：Full Linkage Community Care。専門支援：SeniorDeli。',
  'en':    'HK Care Food Knowledge Hub. Organised by Full Linkage Community Care Association. Supported by SeniorDeli.',
};

const knowledgeLinks: Record<LangKey, { href: string; label: string }[]> = {
  'zh-hk': [
    { href: '/zh-hk/dysphagia/', label: '吞嚥困難基礎' },
    { href: '/zh-hk/iddsi-guide/', label: 'IDDSI 指南' },
    { href: '/zh-hk/gba-standard/', label: '大灣區標準' },
    { href: '/zh-hk/for-professionals/', label: '專業人士資源' },
    { href: '/zh-hk/about/', label: '關於我們' },
  ],
  'zh-cn': [
    { href: '/zh-cn/dysphagia/', label: '吞咽困难基础' },
    { href: '/zh-cn/iddsi-guide/', label: 'IDDSI 指南' },
    { href: '/zh-cn/gba-standard/', label: '大湾区标准' },
    { href: '/zh-cn/for-professionals/', label: '专业人士资源' },
    { href: '/zh-cn/about/', label: '关于我们' },
  ],
  'ja': [
    { href: '/ja/dysphagia/', label: '嚥下障害の基礎' },
    { href: '/ja/iddsi-guide/', label: 'IDDSIガイド' },
    { href: '/ja/for-professionals/', label: '専門家向けリソース' },
    { href: '/ja/about/', label: '私たちについて' },
  ],
  'en': [
    { href: '/en/dysphagia/', label: 'Dysphagia Basics' },
    { href: '/en/iddsi-guide/', label: 'IDDSI Guide' },
    { href: '/en/gba-standard/', label: 'GBA Standard' },
    { href: '/en/for-professionals/', label: 'For Professionals' },
    { href: '/en/about/', label: 'About Us' },
  ],
};

const toolLinks: Record<LangKey, { href: string; label: string }[]> = {
  'zh-hk': [
    { href: '/zh-hk/recipes/', label: '食譜庫' },
    { href: '/zh-hk/tools/', label: '數碼工具' },
    { href: '/zh-hk/resources/', label: '資源下載' },
    { href: '/zh-hk/supplier-directory/', label: '供應商目錄' },
  ],
  'zh-cn': [
    { href: '/zh-cn/recipes/', label: '食谱库' },
    { href: '/zh-cn/tools/', label: '数码工具' },
    { href: '/zh-cn/resources/', label: '资源下载' },
    { href: '/zh-cn/supplier-directory/', label: '供应商目录' },
  ],
  'ja': [
    { href: '/ja/recipes/', label: 'レシピ集' },
    { href: '/ja/tools/', label: 'ツール' },
    { href: '/ja/resources/', label: 'リソース' },
  ],
  'en': [
    { href: '/en/recipes/', label: 'Recipe Library' },
    { href: '/en/tools/', label: 'Digital Tools' },
    { href: '/en/resources/', label: 'Resources' },
    { href: '/en/supplier-directory/', label: 'Supplier Directory' },
  ],
};

const ctaTexts: Record<LangKey, { title: string; sub: string; btn: string }> = {
  'zh-hk': {
    title: '為院舍提供 IDDSI 臨床工具？',
    sub: 'EAT-10 篩查 · IDDSI 匹配 · 食物照片識別 — 免費臨床應用程式',
    btn: '免費下載應用程式 →',
  },
  'zh-cn': {
    title: '为院舍提供 IDDSI 临床工具？',
    sub: 'EAT-10 筛查 · IDDSI 匹配 · 食物照片识别 — 免费临床应用程式',
    btn: '免费下载应用程式 →',
  },
  'ja': {
    title: 'IDDSIの臨床ツールをお探しですか？',
    sub: 'EAT-10スクリーナー · IDDSIマッチャー · スナップ分類 — 無料臨床アプリ',
    btn: '無料アプリをダウンロード →',
  },
  'en': {
    title: 'IDDSI clinical tools for your care home?',
    sub: 'EAT-10 screener · IDDSI Matcher · Snap-to-IDDSI classifier — free clinical app',
    btn: 'Free App Download →',
  },
};

const disclaimers: Record<LangKey, string> = {
  'zh-hk': '本網站資訊僅供教育參考，不構成醫療建議。如有吞嚥問題，請諮詢合資格言語治療師。',
  'zh-cn': '本网站资讯仅供教育参考，不构成医疗建议。如有吞咽问题，请咨询合资格言语治疗师。',
  'ja':    '本サイトの情報は教育目的のみであり、医療アドバイスを構成するものではありません。嚥下に関する懸念は言語聴覚士にご相談ください。',
  'en':    'Information on this site is for educational purposes only and does not constitute medical advice. Consult a qualified speech therapist for swallowing concerns.',
};

const h = headings[l];
const cta = ctaTexts[l];
const disclaimer = disclaimers[l];
---

<footer class="bg-gray-900 text-gray-400 mt-16">
  <!-- CTA Banner -->
  <div class="border-b border-gray-800">
    <div class="max-w-6xl mx-auto px-4 py-6">
      <div class="flex flex-wrap items-center justify-between gap-4 bg-primary-700/20 border border-primary-700/40 rounded-xl px-6 py-5">
        <div>
          <p class="text-white font-semibold text-base mb-1">🍽️ {cta.title}</p>
          <p class="text-primary-300 text-sm">{cta.sub}</p>
        </div>
        <a href="https://seniordeli.com/"
           target="_blank" rel="noopener"
           class="btn-primary flex-shrink-0 no-underline text-sm">
          {cta.btn}
        </a>
      </div>
    </div>
  </div>

  <!-- Main footer grid -->
  <div class="max-w-6xl mx-auto px-4 py-10">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">

      <!-- Col 1: Brand -->
      <div>
        <h3 class="text-white font-bold text-base mb-3">{h.brand}</h3>
        <p class="text-sm leading-relaxed mb-3">{taglines[l]}</p>
        <p class="text-sm">
          📧 <a href="mailto:info@softmeal.org" class="text-gray-300 hover:text-white transition-colors inline-flex items-center min-h-[44px] min-w-[44px]">info@softmeal.org</a>
        </p>
      </div>

      <!-- Col 2: Knowledge -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-3">{h.knowledge}</h3>
        <ul class="space-y-1.5 text-sm">
          {knowledgeLinks[l].map(link => (
            <li>
              <a href={link.href} class="text-gray-300 hover:text-white transition-colors no-underline inline-flex items-center min-h-[44px] min-w-[44px]">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: Recipes & Tools -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-3">{h.tools}</h3>
        <ul class="space-y-1.5 text-sm">
          {toolLinks[l].map(link => (
            <li>
              <a href={link.href} class="text-gray-300 hover:text-white transition-colors no-underline inline-flex items-center min-h-[44px] min-w-[44px]">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Related Properties -->
      <div>
        <h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-3">{h.partners}</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="https://seniordeli.com/" target="_blank" rel="noopener"
               class="text-gray-300 hover:text-white transition-colors no-underline inline-flex items-center min-h-[44px] min-w-[44px]">
              seniordeli.com <span class="text-gray-400">— HK</span>
            </a>
          </li>
          <li>
            <a href="https://asaptic.com/" target="_blank" rel="noopener"
               class="text-gray-300 hover:text-white transition-colors no-underline inline-flex items-center min-h-[44px] min-w-[44px]">
              asaptic.com <span class="text-gray-400">— CN</span>
            </a>
          </li>
          <li>
            <a href="https://dysphagia.cn/" target="_blank" rel="noopener"
               class="text-gray-300 hover:text-white transition-colors no-underline inline-flex items-center min-h-[44px] min-w-[44px]">
              dysphagia.cn <span class="text-gray-400">— CN</span>
            </a>
          </li>
        </ul>

        <!-- Free tools widget -->
        <div class="mt-5 pt-4 border-t border-gray-800">
          <p class="text-xs text-gray-400 uppercase tracking-wider mb-2">SeniorDeli Free Tools</p>
          <div class="flex flex-col gap-1.5">
            <a href="https://seniordeli.com/" target="_blank" rel="noopener"
               class="text-xs text-blue-400 hover:text-blue-300 no-underline transition-colors min-h-[44px] inline-flex items-center">
              📋 EAT-10 Screening
            </a>
            <a href="https://seniordeli.com/" target="_blank" rel="noopener"
               class="text-xs text-blue-400 hover:text-blue-300 no-underline transition-colors min-h-[44px] inline-flex items-center">
              🔢 IDDSI Matcher Tool
            </a>
            <a href="https://seniordeli.com/" target="_blank" rel="noopener"
               class="text-xs text-blue-400 hover:text-blue-300 no-underline transition-colors min-h-[44px] inline-flex items-center">
              📷 Snap-to-IDDSI Camera
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="mt-8 pt-6 border-t border-gray-800 flex flex-wrap gap-4 items-center justify-between text-xs text-gray-600">
      <p>© 2026 softmeal.org · Founded by <a href="https://ycchau.com/en/about/" rel="me" class="text-gray-400 hover:text-gray-200 transition-colors underline">Raymond Chau Yik-Chun (周益俊)</a></p>
      <p class="text-center flex-1 min-w-0 leading-relaxed">{disclaimer}</p>
      <a href={`/${l}/about/`} class="text-gray-400 hover:text-gray-200 transition-colors no-underline flex-shrink-0 inline-flex items-center min-h-[44px] min-w-[44px]">
        {l === 'zh-hk' ? '免責聲明' : l === 'zh-cn' ? '免责声明' : l === 'ja' ? '免責事項' : 'Disclaimer'}
      </a>
    </div>
  </div>
</footer>
