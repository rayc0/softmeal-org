---
interface Row {
  item: string;
  qty: string | number;
  unit: string;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

<table class="ingredient-table w-full text-sm border-collapse" style="font-variant-numeric: tabular-nums;">
  <tbody>
    {rows.map((row) => (
      <tr class="border-t border-ink/15 first:border-t-0">
        <td class="py-2 pr-4 text-left">{row.item}</td>
        <td class="py-2 pl-4 text-right whitespace-nowrap">{row.qty} {row.unit}</td>
      </tr>
    ))}
  </tbody>
</table>
