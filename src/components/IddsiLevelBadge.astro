---
interface Props {
  level: number;
  lang?: string;
  variant?: 'pill' | 'medallion';
}

const { level, lang = 'zh-hk', variant = 'pill' } = Astro.props;

type LangKey = 'zh-hk' | 'zh-cn' | 'ja' | 'en';
const validLangs = new Set<string>(['zh-hk', 'zh-cn', 'ja', 'en']);
const l: LangKey = validLangs.has(lang) ? lang as LangKey : 'zh-hk';

const labels: Record<LangKey, Record<number, string>> = {
  'zh-hk': {
    0: 'Level 0 稀薄',
    1: 'Level 1 極微稠杰',
    2: 'Level 2 低度稠杰',
    3: 'Level 3 中度稠杰',
    4: 'Level 4 糊狀',
    5: 'Level 5 細碎及濕軟',
    6: 'Level 6 軟質及一口量',
    7: 'Level 7EC 容易咀嚼',
  },
  'zh-cn': {
    0: 'Level 0 稀薄液体',
    1: 'Level 1 微稠',
    2: 'Level 2 低稠',
    3: 'Level 3 中稠',
    4: 'Level 4 糊状',
    5: 'Level 5 细碎湿软',
    6: 'Level 6 软质一口量',
    7: 'Level 7EC 易咀嚼',
  },
  'ja': {
    0: 'Level 0 薄い液体',
    1: 'Level 1 やや濃い',
    2: 'Level 2 濃い',
    3: 'Level 3 とろみ状',
    4: 'Level 4 ペースト状',
    5: 'Level 5 ミンチ状',
    6: 'Level 6 軟らか一口',
    7: 'Level 7EC 噛みやすい',
  },
  'en': {
    0: 'Level 0 Thin',
    1: 'Level 1 Slightly Thick',
    2: 'Level 2 Mildly Thick',
    3: 'Level 3 Moderately Thick',
    4: 'Level 4 Puréed',
    5: 'Level 5 Minced & Moist',
    6: 'Level 6 Soft & Bite-Sized',
    7: 'Level 7EC Easy to Chew',
  },
};

// Official IDDSI Pantone-derived palette
const palette: Record<number, { bg: string; color: string; dot: string }> = {
  0: { bg: '#f5f5f5', color: '#555',  dot: '#d1d5db' },
  1: { bg: '#9B9B9B', color: '#fff',  dot: '#6b7280' },
  2: { bg: '#E91E8C', color: '#fff',  dot: '#be185d' },
  3: { bg: '#FFD700', color: '#333',  dot: '#b45309' },
  4: { bg: '#2E7D32', color: '#fff',  dot: '#14532d' },
  5: { bg: '#E65100', color: '#fff',  dot: '#9a3412' },
  6: { bg: '#1565C0', color: '#fff',  dot: '#1e3a8a' },
  7: { bg: '#E65100', color: '#fff',  dot: '#9a3412' },
};

const info  = palette[level]  ?? palette[4];
const label = labels[l]?.[level] ?? `Level ${level}`;

// Split label into "Level N" and the descriptor for medallion layout
const labelParts = label.match(/^(Level \d+(?:EC)?)\s+(.+)$/);
const levelNum = labelParts?.[1] ?? `Level ${level}`;
const levelDesc = labelParts?.[2] ?? label;
---

{variant === 'medallion' ? (
  <div
    class="medallion flex flex-col items-center justify-center rounded-full shadow-lg select-none"
    style={`background-color: ${info.bg}; color: ${info.color}; width: 80px; height: 80px; border: 3px solid ${info.dot};`}
    aria-label={label}
    title={label}
  >
    <span
      class="font-black leading-none tabular-nums"
      style="font-size: 32px; line-height: 1;"
    >
      {level === 7 ? '7' : String(level)}
    </span>
    <span
      class="font-semibold text-center px-1 opacity-90 leading-snug"
      style="font-size: 11px; letter-spacing: 0.055em;"
      aria-hidden="true"
    >
      {levelDesc.length > 6 ? levelDesc.slice(0, 5) + '…' : levelDesc}
    </span>
    <span class="sr-only">{label}</span>
  </div>
) : (
  <span
    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-sm font-semibold"
    style={`background-color: ${info.bg}; color: ${info.color};`}
  >
    <span
      class="inline-block w-2 h-2 rounded-full flex-shrink-0"
      style={`background-color: ${info.dot};`}
      aria-hidden="true"
    ></span>
    {label}
  </span>
)}
