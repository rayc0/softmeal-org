---
interface Props {
  level: number;
  lang?: string;
}

const { level, lang = 'zh-hk' } = Astro.props;

type LangKey = 'zh-hk' | 'zh-cn' | 'ja' | 'en';
const l = (lang as LangKey) in labels ? (lang as LangKey) : 'zh-hk';

const labels: Record<LangKey, Record<number, string>> = {
  'zh-hk': {
    0: 'Level 0 稀薄',
    1: 'Level 1 極微稠杰',
    2: 'Level 2 低度稠杰',
    3: 'Level 3 中度稠杰',
    4: 'Level 4 糊狀',
    5: 'Level 5 細碎及濕軟',
    6: 'Level 6 軟質及一口量',
    7: 'Level 7EC 容易咀嚼',
  },
  'zh-cn': {
    0: 'Level 0 稀薄液体',
    1: 'Level 1 微稠',
    2: 'Level 2 低稠',
    3: 'Level 3 中稠',
    4: 'Level 4 糊状',
    5: 'Level 5 细碎湿软',
    6: 'Level 6 软质一口量',
    7: 'Level 7EC 易咀嚼',
  },
  'ja': {
    0: 'Level 0 薄い液体',
    1: 'Level 1 やや濃い',
    2: 'Level 2 濃い',
    3: 'Level 3 とろみ状',
    4: 'Level 4 ペースト状',
    5: 'Level 5 ミンチ状',
    6: 'Level 6 軟らか一口',
    7: 'Level 7EC 噛みやすい',
  },
  'en': {
    0: 'Level 0 Thin',
    1: 'Level 1 Slightly Thick',
    2: 'Level 2 Mildly Thick',
    3: 'Level 3 Moderately Thick',
    4: 'Level 4 Puréed',
    5: 'Level 5 Minced & Moist',
    6: 'Level 6 Soft & Bite-Sized',
    7: 'Level 7EC Easy to Chew',
  },
};

const colors: Record<number, { bg: string; color: string }> = {
  0: { bg: '#f5f5f5', color: '#555' },
  1: { bg: '#9B9B9B', color: '#fff' },
  2: { bg: '#E91E8C', color: '#fff' },
  3: { bg: '#FFD700', color: '#333' },
  4: { bg: '#2E7D32', color: '#fff' },
  5: { bg: '#E65100', color: '#fff' },
  6: { bg: '#1565C0', color: '#fff' },
  7: { bg: '#E65100', color: '#fff' },
};

const info = colors[level] ?? colors[4];
const label = labels[l]?.[level] ?? `Level ${level}`;
---

<span
  class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold"
  style={`background-color: ${info.bg}; color: ${info.color};`}
>
  {label}
</span>
