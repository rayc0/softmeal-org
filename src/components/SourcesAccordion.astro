---
export interface Source {
  n: number;
  citation: string;
  url?: string;
}

export interface Props {
  sources: Source[];
  /** Override the summary label; defaults to "<n> sources" */
  label?: string;
}

const { sources, label } = Astro.props;
const count = sources.length;
const summaryLabel = label ?? `${count} source${count !== 1 ? 's' : ''}`;
---

<details class="sources-accordion not-prose my-8 border border-ink-200 rounded-md text-sm">
  <summary class="flex items-center gap-2 cursor-pointer select-none px-4 py-3 text-ink-600 hover:text-ink-900 hover:bg-ink-50 rounded-md transition-colors list-none [&::-webkit-details-marker]:hidden">
    <!-- Book-open icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="shrink-0"
    >
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
    </svg>
    <span class="font-medium">{summaryLabel}</span>
    <!-- Chevron that rotates when open -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="sources-chevron ml-auto shrink-0 transition-transform duration-200"
    >
      <path d="m6 9 6 6 6-6"/>
    </svg>
  </summary>

  <ol class="m-0 px-4 pb-4 pt-2 space-y-2 list-none">
    {sources.map((src) => (
      <li id={`source-${src.n}`} class="flex gap-2 leading-snug text-ink-600">
        <span class="shrink-0 font-medium text-ink-400 w-5 text-right">{src.n}.</span>
        <span>
          {src.url ? (
            <a
              href={src.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-ink-700 underline underline-offset-2 decoration-ink-300 hover:decoration-ink-600 break-words"
            >
              {src.citation}
            </a>
          ) : (
            src.citation
          )}
        </span>
      </li>
    ))}
  </ol>
</details>

<style>
  details[open] .sources-chevron {
    transform: rotate(180deg);
  }
</style>
