---
interface Props {
  facts: string[];
  sources?: { label: string; url: string }[];
  title?: string;
}
const { facts, sources, title = 'Quick Facts' } = Astro.props;
---
<aside class="my-6 rounded-lg border-l-4 border-primary bg-primary/5 p-4 not-prose">
  <h3 class="text-sm font-semibold uppercase tracking-wider mb-2">{title}</h3>
  <ul class="space-y-1 text-sm">
    {facts.map(f => <li set:html={f} />)}
  </ul>
  {sources && (
    <div class="mt-3 text-xs text-gray-500">
      Sources: {sources.map((s, i) => (
        <>
          {i > 0 && ' | '}
          <a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
        </>
      ))}
    </div>
  )}
</aside>
