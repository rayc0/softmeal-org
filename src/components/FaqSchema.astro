---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  questions: FaqItem[];
}

const { questions } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": questions.map(({ question, answer }) => ({
    "@type": "Question",
    "name": question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": answer,
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
