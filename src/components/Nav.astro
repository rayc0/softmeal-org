---
import LocaleSwitcher from './LocaleSwitcher.astro';
import FontSizeControl from './FontSizeControl.astro';

interface HreflangEntry {
  hreflang: string;
  href: string;
}

interface Props {
  lang: string;
  currentPath?: string;
  hreflangLinks?: HreflangEntry[];
}

const { lang, hreflangLinks } = Astro.props;

type LangKey = 'zh-hk' | 'zh-cn' | 'ja' | 'en';
const VALID_LANGS = new Set<string>(['zh-hk', 'zh-cn', 'ja', 'en']);
const l: LangKey = VALID_LANGS.has(lang) ? (lang as LangKey) : 'zh-hk';

// Nav links per language
const navLinks: Record<LangKey, { href: string; label: string }[]> = {
  'zh-hk': [
    { href: '/zh-hk/', label: '首頁' },
    { href: '/zh-hk/dysphagia/', label: '吞嚥困難' },
    { href: '/zh-hk/iddsi-guide/', label: 'IDDSI 指南' },
    { href: '/zh-hk/gba-standard/', label: '灣區標準' },
    { href: '/zh-hk/recipes/', label: '食譜庫' },
    { href: '/zh-hk/resources/', label: '資源下載' },
    { href: '/zh-hk/tools/', label: '數碼工具' },
    { href: '/zh-hk/for-professionals/', label: '專業人士' },
    { href: '/zh-hk/about/', label: '關於我們' },
  ],
  'zh-cn': [
    { href: '/zh-cn/', label: '首页' },
    { href: '/zh-cn/dysphagia/', label: '吞咽困难' },
    { href: '/zh-cn/iddsi-guide/', label: 'IDDSI 指南' },
    { href: '/zh-cn/gba-standard/', label: '湾区标准' },
    { href: '/zh-cn/recipes/', label: '食谱库' },
    { href: '/zh-cn/resources/', label: '资源下载' },
    { href: '/zh-cn/tools/', label: '数码工具' },
    { href: '/zh-cn/for-professionals/', label: '专业人士' },
    { href: '/zh-cn/about/', label: '关于我们' },
  ],
  'ja': [
    { href: '/ja/', label: 'ホーム' },
    { href: '/ja/dysphagia/', label: '嚥下障害' },
    { href: '/ja/iddsi-guide/', label: 'IDDSIガイド' },
    { href: '/ja/recipes/', label: 'レシピ集' },
    { href: '/ja/resources/', label: 'リソース' },
    { href: '/ja/tools/', label: 'ツール' },
    { href: '/ja/for-professionals/', label: '専門家向け' },
    { href: '/ja/about/', label: '私たちについて' },
  ],
  'en': [
    { href: '/en/', label: 'Home' },
    { href: '/en/dysphagia/', label: 'Dysphagia' },
    { href: '/en/iddsi-guide/', label: 'IDDSI Guide' },
    { href: '/en/gba-standard/', label: 'GBA Standard' },
    { href: '/en/recipes/', label: 'Recipes' },
    { href: '/en/resources/', label: 'Resources' },
    { href: '/en/tools/', label: 'Tools' },
    { href: '/en/for-professionals/', label: 'Professionals' },
    { href: '/en/about/', label: 'About' },
  ],
};

const taglines: Record<LangKey, string> = {
  'zh-hk': '香港照護食知識中心',
  'zh-cn': '香港照护食知识中心',
  'ja':    'HK 介護食ナレッジセンター',
  'en':    'HK Care Food Knowledge Hub',
};

const appLabels: Record<LangKey, string> = {
  'zh-hk': '免費 App',
  'zh-cn': '免费 App',
  'ja':    '無料アプリ',
  'en':    'Free App',
};

// Language switcher options
const langOptions: { code: LangKey; label: string; href: string }[] = [
  { code: 'zh-hk', label: '繁體中文', href: '/zh-hk/' },
  { code: 'zh-cn', label: '简体中文', href: '/zh-cn/' },
  { code: 'ja',    label: '日本語',   href: '/ja/' },
  { code: 'en',    label: 'English',  href: '/en/' },
];

const enLinks = [
  { href: `/en/`, label: 'Home' },
  { href: `/en/dysphagia/`, label: 'Dysphagia' },
  { href: `/en/iddsi-guide/`, label: 'IDDSI Guide' },
  { href: `/en/gba-standard/`, label: 'GBA Standard' },
  { href: `/en/recipes/`, label: 'Recipes' },
  { href: `/en/resources/`, label: 'Resources' },
  { href: `/en/tools/`, label: 'Tools' },
  { href: `/en/for-professionals/`, label: 'Professionals' },
  { href: `/en/supplier-directory/`, label: 'Suppliers' },
  { href: `/en/about/`, label: 'About' },
];

const tagline = taglines[l] ?? taglines['en'];
const appLabel = appLabels[l] ?? appLabels['en'];

const careEZLabels: Record<LangKey, string> = {
  'zh-hk': 'CareEZ 臨床AI ↗',
  'zh-cn': 'CareEZ 临床AI ↗',
  'ja':    'CareEZ ↗',
  'en':    'CareEZ ↗',
};
const careEZLabel = careEZLabels[l] ?? careEZLabels['en'];

const links = navLinks[l] ?? navLinks['en'];
---

<script>
  const btn = document.getElementById('theme-toggle');
  const sun = document.getElementById('theme-icon-sun');
  const moon = document.getElementById('theme-icon-moon');

  function syncIcon() {
    const dark = document.documentElement.getAttribute('data-theme') === 'dark';
    sun?.classList.toggle('hidden', !dark);
    moon?.classList.toggle('hidden', dark);
  }

  syncIcon();

  btn?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    syncIcon();
  });
</script>

<!-- CSS-only hamburger toggle -->
<input type="checkbox" id="nav-toggle" class="sr-only peer/nav" />

<header class="sticky top-0 z-40 bg-primary-700/95 backdrop-blur-sm text-white shadow-md">
  <div class="max-w-6xl mx-auto px-4 py-3">
    <div class="flex items-center justify-between gap-4">

      <!-- Logo -->
      <a href={`/${l}/`} class="flex items-center gap-2 min-h-[48px] no-underline hover:no-underline group">
        <span class="text-lg font-bold text-white group-hover:text-primary-100 transition-colors">
          softmeal.org
        </span>
        <span class="hidden sm:inline text-xs font-normal text-primary-200 group-hover:text-primary-100 transition-colors">
          {tagline}
        </span>
      </a>

      <!-- Right controls: lang switcher + app link + hamburger -->
      <div class="flex items-center gap-2">

        <!-- Language switcher pill row -->
        <LocaleSwitcher lang={l} hreflangLinks={hreflangLinks} />

        <!-- App CTA -->
        <a href="https://seniordeli.com/" target="_blank" rel="noopener"
           class="hidden sm:inline-flex items-center gap-1 min-h-[48px] text-xs text-primary-200 hover:text-white border border-primary-600 hover:border-primary-400 px-2.5 py-1 rounded-md transition-colors no-underline">
          {appLabel} ↗
        </a>

        <!-- Font size control (A / A+ / A++) — for 65+ audience -->
        <FontSizeControl />

        <!-- Theme toggle -->
        <button id="theme-toggle"
                class="min-h-[48px] min-w-[48px] flex items-center justify-center rounded hover:bg-primary-600 transition-colors text-primary-200 hover:text-white"
                aria-label="Toggle dark mode">
          <!-- Moon: shown in light mode -->
          <svg id="theme-icon-moon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M21 12.79A9 9 0 1111.21 3a7 7 0 009.79 9.79z" />
          </svg>
          <!-- Sun: shown in dark mode -->
          <svg id="theme-icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 3v1m0 16v1m8.66-9h-1M4.34 12h-1m15.07-6.07-.71.71M6.34 17.66l-.71.71M17.66 17.66l.71.71M6.34 6.34l-.71-.71M12 8a4 4 0 100 8 4 4 0 000-8z" />
          </svg>
        </button>

        <!-- Hamburger label -->
        <label for="nav-toggle"
               class="md:hidden cursor-pointer min-h-[48px] min-w-[48px] flex items-center justify-center rounded hover:bg-primary-600 transition-colors"
               aria-label="Toggle navigation">
          <!-- Hamburger icon (hides when open) -->
          <svg class="w-6 h-6 peer-checked/nav:hidden block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <!-- Close icon (shows when open) -->
          <svg class="w-6 h-6 peer-checked/nav:block hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </label>
      </div>
    </div>

    <!-- Desktop nav links -->
    <nav class="hidden md:block mt-2 overflow-x-auto" aria-label="Main navigation">
      <ul class="flex gap-1 text-sm whitespace-nowrap items-center">
        {links.map(link => (
          <li>
            <a href={link.href}
               class="inline-flex items-center min-h-[48px] text-primary-100 hover:text-white hover:bg-primary-600 no-underline px-2.5 py-1 rounded transition-colors">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- Mobile nav (toggled by checkbox) -->
  <div class="md:hidden max-h-0 overflow-hidden peer-checked/nav:max-h-screen transition-all duration-300 bg-primary-800">
    <nav class="px-4 py-3 border-t border-primary-600" aria-label="Mobile navigation">
      <ul class="flex flex-col gap-1">
        {links.map(link => (
          <li>
            <a href={link.href}
               class="flex items-center min-h-[48px] text-primary-100 hover:text-white hover:bg-primary-700 no-underline px-3 py-2 rounded transition-colors">
              {link.label}
            </a>
          </li>
        ))}
        <li class="mt-2 pt-2 border-t border-primary-700">
          <a href="https://seniordeli.com/" target="_blank" rel="noopener"
             class="flex items-center min-h-[48px] text-primary-200 hover:text-white no-underline px-3 py-2 text-sm">
            {appLabel} ↗
          </a>
        </li>
        <li class="pl-2 border-l border-green-700">
          <a href="https://careez.org" target="_blank" rel="noopener"
             class="flex items-center min-h-[48px] text-yellow-300 hover:text-white no-underline text-xs font-semibold">
            {careEZLabel}
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
