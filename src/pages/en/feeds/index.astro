---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const siteUrl = 'https://softmeal.org';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "inLanguage": "en",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": `${siteUrl}/en/` },
    { "@type": "ListItem", "position": 2, "name": "Feeds", "item": `${siteUrl}/en/feeds/` }
  ]
};

const feeds = [
  {
    locale: 'en',
    label: 'English',
    rss: `${siteUrl}/en/rss.xml`,
    atom: `${siteUrl}/en/atom.xml`,
  },
  {
    locale: 'zh-hk',
    label: '繁體中文',
    rss: `${siteUrl}/zh-hk/rss.xml`,
    atom: `${siteUrl}/zh-hk/atom.xml`,
  },
  {
    locale: 'zh-cn',
    label: '简体中文',
    rss: `${siteUrl}/zh-cn/rss.xml`,
    atom: `${siteUrl}/zh-cn/atom.xml`,
  },
  {
    locale: 'ja',
    label: '日本語',
    rss: `${siteUrl}/ja/rss.xml`,
    atom: `${siteUrl}/ja/atom.xml`,
  },
];
---

<BaseLayout
  title="softmeal.org — Feed Directory"
  description="RSS and Atom feed directory for softmeal.org — subscribe in your preferred language and feed reader."
  lang="en"
  canonicalUrl={`${siteUrl}/en/feeds/`}
  schemaJson={[breadcrumbSchema]}
>
  <main style="max-width:680px;margin:3rem auto;padding:0 1.5rem;font-family:system-ui,sans-serif;color:#1a1a1a;">
    <h1 style="font-size:1.75rem;margin-bottom:0.25rem;">Feed Directory</h1>
    <p style="color:#555;margin-bottom:2rem;">
      Subscribe to softmeal.org updates in your preferred language using any RSS/Atom reader.
    </p>
    {feeds.map((f) => (
      <section style="margin-bottom:2rem;padding:1.25rem 1.5rem;border:1px solid #e5e7eb;border-radius:8px;">
        <h2 style="margin:0 0 0.75rem;font-size:1.1rem;">{f.label}</h2>
        <div style="display:flex;gap:1rem;flex-wrap:wrap;">
          <a href={f.rss} style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.4rem 0.9rem;background:#f97316;color:#fff;border-radius:5px;text-decoration:none;font-size:0.9rem;font-weight:500;">
            RSS 2.0
          </a>
          <a href={f.atom} style="display:inline-flex;align-items:center;gap:0.4rem;padding:0.4rem 0.9rem;background:#3b82f6;color:#fff;border-radius:5px;text-decoration:none;font-size:0.9rem;font-weight:500;">
            Atom
          </a>
        </div>
        <p style="margin:0.75rem 0 0;font-size:0.85rem;color:#666;">
          RSS: <code style="background:#f5f5f5;padding:0.1rem 0.3rem;border-radius:3px;">{f.rss}</code>
        </p>
        <p style="margin:0.25rem 0 0;font-size:0.85rem;color:#666;">
          Atom: <code style="background:#f5f5f5;padding:0.1rem 0.3rem;border-radius:3px;">{f.atom}</code>
        </p>
      </section>
    ))}
    <p style="font-size:0.85rem;color:#888;margin-top:2rem;">
      Each feed includes the 30 most recently updated articles and recipes. Feeds update on every deployment.
    </p>
  </main>
</BaseLayout>
