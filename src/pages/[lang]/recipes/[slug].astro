---
import { getCollection } from 'astro:content';
import RecipeLayout from '../../../layouts/RecipeLayout.astro';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((recipe) => {
    const parts = recipe.id.split('/');
    const lang = parts[0];
    const slug = parts[parts.length - 1].replace(/\.mdx?$/, '');
    return {
      params: { lang, slug },
      props: { recipe },
    };
  });
}

const { recipe } = Astro.props;
const { Content } = await recipe.render();
const {
  lang,
  title,
  description,
  hreflang_pair,
  iddsi_level,
  prep_time_minutes,
  difficulty,
  main_ingredient,
  tags,
  last_modified,
  fork_test_pass,
} = recipe.data;

const hreflangPairLang = lang === 'zh-hk' ? 'en' : 'zh-hk';
const siteUrl = 'https://softmeal.org';
const recipeSlug = Astro.params.slug;

const recipeSchema = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": title,
  "description": `${description} IDDSI Level ${iddsi_level} compliant.`,
  "recipeCategory": `IDDSI Level ${iddsi_level}`,
  "prepTime": `PT${prep_time_minutes}M`,
  "recipeYield": "1 serving",
  "inLanguage": lang === 'zh-hk' ? 'zh-HK' : 'en',
  "dateModified": last_modified,
  "author": { "@id": `${siteUrl}/#org` },
  "publisher": { "@id": `${siteUrl}/#org` },
};

// BreadcrumbList schema — 3-level: Home > Recipes > Recipe Title
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "inLanguage": lang === 'zh-hk' ? 'zh-HK' : 'en',
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": lang === 'zh-hk' ? "主頁" : "Home", "item": `${siteUrl}/${lang}/`},
    {"@type": "ListItem", "position": 2, "name": lang === 'zh-hk' ? "食譜" : "Recipes", "item": `${siteUrl}/${lang}/recipes/`},
    {"@type": "ListItem", "position": 3, "name": title, "item": `${siteUrl}/${lang}/recipes/${recipeSlug}/`}
  ]
};
---

<RecipeLayout
  title={title}
  description={description}
  lang={lang}
  hreflangPair={hreflang_pair}
  hreflangPairLang={hreflangPairLang}
  iddsiLevel={iddsi_level}
  prepTimeMinutes={prep_time_minutes}
  difficulty={difficulty}
  mainIngredient={main_ingredient}
  tags={tags}
  schemaJson={[recipeSchema, breadcrumbSchema]}
>
  <h1>{title}</h1>
  <Content />
</RecipeLayout>
