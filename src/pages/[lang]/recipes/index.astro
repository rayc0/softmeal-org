---
// /[lang]/recipes/ — always page 1 of the paginated recipe index.
// Subsequent pages live at /[lang]/recipes/2/, /3/, etc. ([page].astro).
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import CategoryListItem from '../../../components/CategoryListItem.astro';

export async function getStaticPaths() {
  const allRecipes = await getCollection('recipes');
  const langs = [...new Set(allRecipes.map((r: { data: { lang: string } }) => r.data.lang))];
  return langs.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;

type LangKey = 'zh-hk' | 'zh-cn' | 'ja' | 'en';
const l = lang as LangKey;

const PAGE_SIZE = 24;

const titles: Record<LangKey, string> = {
  'zh-hk': '照護食食譜庫 | IDDSI Level 4-6 食譜 — softmeal.org',
  'zh-cn': '照护食食谱库 | IDDSI Level 4-6 食谱 — softmeal.org',
  'ja':    '介護食レシピ集 | IDDSI レベル別レシピ — softmeal.org',
  'en':    'Care Food Recipe Library | IDDSI Level 4-6 Recipes — softmeal.org',
};
const descriptions: Record<LangKey, string> = {
  'zh-hk': '超過10個按 IDDSI 級別分類的照護食食譜，用香港常見食材，適合吞嚥困難長者。免費閱覽。',
  'zh-cn': '超过10个按 IDDSI 级别分类的照护食食谱，使用常见食材，适合吞咽困难老人。免费阅览。',
  'ja':    'IDDSI レベル別に分類した介護食レシピ集。嚥下困難の方に適したレシピを無料公開。',
  'en':    'Over 10 care food recipes categorised by IDDSI level, using common ingredients. Free to read.',
};
const headings: Record<LangKey, string> = {
  'zh-hk': '食譜庫',
  'zh-cn': '食谱库',
  'ja':    'レシピ集',
  'en':    'Recipe Library',
};
const subtexts: Record<LangKey, string> = {
  'zh-hk': '以下食譜均按 IDDSI 級別分類，由低至高排列。每個食譜均包含材料、做法及叉子壓力測試結果。',
  'zh-cn': '以下食谱均按 IDDSI 级别分类，由低至高排列。每个食谱包含食材、做法及叉子压力测试结果。',
  'ja':    '以下のレシピは IDDSI レベル順に並んでいます。各レシピには材料、作り方、フォークテスト結果を含みます。',
  'en':    'Recipes below are categorised by IDDSI level, sorted lowest to highest. Each includes ingredients, method, and fork pressure test results.',
};
const minLabels: Record<LangKey, string> = { 'zh-hk': '分鐘', 'zh-cn': '分钟', 'ja': '分', 'en': 'min' };
const warningTexts: Record<LangKey, string> = {
  'zh-hk': '⚠️ 所有食譜均需由言語治療師評估後確認適合的 IDDSI 級別。食物質感因廚師技術及食材而異。',
  'zh-cn': '⚠️ 所有食谱均需由言语治疗师评估后确认适合的 IDDSI 级别。食物质感因厨师技术及食材而异。',
  'ja':    '⚠️ 全てのレシピは言語聴覚士による評価で適切な IDDSI レベルを確認してください。食感は調理技術や食材により異なります。',
  'en':    '⚠️ All recipes require a speech therapist to confirm the appropriate IDDSI level for each individual. Texture varies by technique and ingredients.',
};
const nextLabels: Record<LangKey, string> = { 'zh-hk': '下一頁 →', 'zh-cn': '下一页 →', 'ja': '次へ →', 'en': 'Next →' };
const faqHeadings: Record<LangKey, string> = {
  'zh-hk': '常見問題',
  'zh-cn': '常见问题',
  'ja': 'よくある質問',
  'en': 'Frequently Asked Questions',
};
const faqItems: Record<LangKey, { q: string; a: string }[]> = {
  'zh-hk': [
    { q: '這些食譜對所有吞嚥困難患者都安全嗎？', a: '食譜按 IDDSI 等級分類，但每位患者的適合等級必須由言語治療師個別評估確定。請勿根據食譜自行決定患者的飲食等級。' },
    { q: '如何找到 IDDSI Level 4 的食譜？', a: '在食譜庫中，每個食譜均標有 IDDSI 等級徽章。向下瀏覽或使用等級篩選器找到 Level 4（糊狀）食譜。每個食譜均包含叉壓測試結果，確認質感達標。' },
    { q: '食譜中的增稠劑用量可以更改嗎？', a: '不建議自行更改增稠劑用量。飲品的增稠程度必須符合言語治療師指定的 IDDSI 等級。不同品牌的增稠劑效果可能不同，應根據品牌說明書及言語治療師的指引使用。' },
    { q: 'softmeal.org 的食譜是否適合糖尿病患者？', a: '食譜主要針對質感調整，未必考慮血糖控制需求。有糖尿病的吞嚥困難患者應諮詢營養師，選擇適合的食譜並調整份量。' },
  ],
  'zh-cn': [
    { q: '这些食谱对所有吞咽困难患者都安全吗？', a: '食谱按 IDDSI 等级分类，但每位患者适合的等级必须由言语治疗师个别评估确定。请勿根据食谱自行决定患者的饮食等级。' },
    { q: '如何找到 IDDSI Level 4 的食谱？', a: '在食谱库中，每个食谱均标有 IDDSI 等级徽章。浏览或使用等级筛选器找到 Level 4（糊状）食谱。每个食谱包含叉压测试结果，确认质感达标。' },
    { q: '食谱中的增稠剂用量可以更改吗？', a: '不建议自行更改增稠剂用量。饮品的增稠程度必须符合言语治疗师指定的 IDDSI 等级。不同品牌效果可能不同，应参考品牌说明书及言语治疗师指引。' },
    { q: 'softmeal.org 的食谱是否适合糖尿病患者？', a: '食谱主要针对质感调整，未必考虑血糖控制需求。有糖尿病的吞咽困难患者应咨询营养师。' },
  ],
  'ja': [
    { q: 'これらのレシピはすべての嚥下困難患者に安全ですか？', a: 'レシピはIDDSIレベル別に分類されていますが、各患者に適したレベルは言語聴覚士による個別評価が必要です。レシピだけで食事レベルを自己判断しないでください。' },
    { q: 'IDDSIレベル4のレシピはどこで見つけられますか？', a: 'レシピ一覧では各レシピにIDDSIレベルバッジが表示されています。レベル4（ピューレ）のレシピを探してください。各レシピにはフォーク圧力テスト結果が含まれています。' },
    { q: 'とろみ剤の量は変更できますか？', a: '自己判断での変更はお勧めしません。飲み物のとろみは言語聴覚士が指定するIDDSIレベルに合わせる必要があります。ブランドによって効果が異なる場合があります。' },
    { q: 'softmeal.orgのレシピは糖尿病患者に適していますか？', a: 'レシピは主に食感調整を目的としており、血糖管理は考慮されていない場合があります。糖尿病をお持ちの方は栄養士にご相談ください。' },
  ],
  'en': [
    { q: 'Are these recipes safe for all dysphagia patients?', a: 'Recipes are categorised by IDDSI level, but each patient\'s appropriate level must be determined by a speech-language therapist. Do not use a recipe to self-assign an IDDSI level for a patient.' },
    { q: 'How do I find a recipe for IDDSI Level 4?', a: 'Each recipe in the library displays an IDDSI level badge. Look for Level 4 (Puréed) recipes — each includes a fork pressure test result confirming the texture meets IDDSI requirements.' },
    { q: 'Can I change the thickener quantity in a recipe?', a: 'It is not recommended to change thickener amounts without clinical guidance. The target IDDSI level for each drink must match the patient\'s prescription. Different thickener brands may require different amounts — follow product instructions and the SLP\'s guidance.' },
    { q: 'Are softmeal.org recipes suitable for patients with diabetes?', a: 'These recipes focus on texture modification and may not account for blood sugar management. Dysphagia patients who also have diabetes should consult a dietitian to select and adapt recipes accordingly.' },
  ],
};
const pageLabels: Record<LangKey, string> = { 'zh-hk': '第', 'zh-cn': '第', 'ja': '第', 'en': 'Page' };
const ofLabels: Record<LangKey, string> = { 'zh-hk': '頁，共', 'zh-cn': '页，共', 'ja': 'ページ、全', 'en': 'of' };
const totalLabels: Record<LangKey, string> = { 'zh-hk': '頁', 'zh-cn': '页', 'ja': 'ページ', 'en': 'pages' };

const allRecipes = await getCollection('recipes', ({ data }) => data.lang === l);
allRecipes.sort((a, b) => a.data.iddsi_level - b.data.iddsi_level);

const siteUrl = 'https://softmeal.org';
// All 4 locales have a recipes index page (driven by getStaticPaths above).
const LOCALE_BCP47_REC: Record<string, string> = { 'zh-hk': 'zh-HK', 'zh-cn': 'zh-CN', 'ja': 'ja', 'en': 'en' };
const hreflangLinks = [
  ...Object.entries(LOCALE_BCP47_REC).map(([locale, bcp47]) => ({
    hreflang: bcp47,
    href: `${siteUrl}/${locale}/recipes/`,
  })),
  { hreflang: 'x-default', href: `${siteUrl}/zh-hk/recipes/` },
];

const totalPages = Math.ceil(allRecipes.length / PAGE_SIZE);
const pageRecipes = allRecipes.slice(0, PAGE_SIZE);
const nextUrl = totalPages > 1 ? `/${lang}/recipes/2/` : undefined;

const htmlLangMap: Record<LangKey, string> = { 'zh-hk': 'zh-HK', 'zh-cn': 'zh-CN', 'ja': 'ja', 'en': 'en' };
const schemaLang = htmlLangMap[l] ?? 'zh-HK';

// BreadcrumbList: Home → Recipes (2-level, locale-aware)
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "inLanguage": schemaLang,
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": l === 'zh-hk' ? "主頁" : l === 'zh-cn' ? "首页" : l === 'ja' ? "ホーム" : "Home", "item": `${siteUrl}/${lang}/` },
    { "@type": "ListItem", "position": 2, "name": l === 'zh-hk' ? "食譜" : l === 'zh-cn' ? "食谱" : l === 'ja' ? "レシピ" : "Recipes", "item": `${siteUrl}/${lang}/recipes/` }
  ]
};

// ItemList: enumerate all recipes on this page sorted by IDDSI level
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "inLanguage": schemaLang,
  "name": l === 'zh-hk' ? "照護食食譜庫" : l === 'zh-cn' ? "照护食食谱库" : l === 'ja' ? "介護食レシピ集" : "Care Food Recipe Library",
  "description": descriptions[l],
  "numberOfItems": allRecipes.length,
  "itemListOrder": "https://schema.org/ItemListOrderAscending",
  "itemListElement": allRecipes.map((recipe, index) => {
    const parts = recipe.id.split('/');
    const recipeSlug = parts[parts.length - 1].replace(/\.mdx?$/, '');
    return {
      "@type": "ListItem",
      "position": index + 1,
      "name": recipe.data.title,
      "url": `${siteUrl}/${lang}/recipes/${recipeSlug}/`
    };
  })
};
---

<PageLayout
  title={titles[l]}
  description={descriptions[l]}
  lang={lang}
  hreflangLinks={hreflangLinks}
  canonicalUrl={`https://softmeal.org/${lang}/recipes/`}
  schemaJson={[breadcrumbSchema, itemListSchema]}
>
  <h1>{headings[l]}</h1>
  <p>{subtexts[l]}</p>

  <div class="mt-6">
    {pageRecipes.map((recipe: { id: string; data: { iddsi_level: number; title: string; description: string; prep_time_minutes: number } }) => {
      const parts = recipe.id.split('/');
      const slug = parts[parts.length - 1].replace(/\.mdx?$/, '');
      return (
        <CategoryListItem
          title={recipe.data.title}
          href={`/${lang}/recipes/${slug}/`}
          description={recipe.data.description}
          iddsiLevel={recipe.data.iddsi_level}
          prepTimeMinutes={recipe.data.prep_time_minutes}
          lang={lang}
        />
      );
    })}
  </div>

  <!-- Pagination nav (only shown when there are multiple pages) -->
  {totalPages > 1 && (
    <nav aria-label="pagination" class="mt-8 flex items-center justify-between gap-4">
      <div>
        {/* No prev on page 1 */}
      </div>

      <span class="text-sm text-gray-500">
        {pageLabels[l]} 1 {ofLabels[l]} {totalPages} {totalLabels[l]}
      </span>

      <div>
        {nextUrl && (
          <a
            href={nextUrl}
            class="inline-block px-4 py-2 border border-gray-300 rounded-lg text-sm hover:border-primary hover:text-primary transition-colors no-underline"
          >
            {nextLabels[l]}
          </a>
        )}
      </div>
    </nav>
  )}

  <div class="mt-8 p-4 bg-yellow-50 border border-yellow-200 rounded text-sm text-yellow-800">
    {warningTexts[l]}
  </div>

  <section class="mt-10">
    <h2 class="text-xl font-semibold mb-4">{faqHeadings[l]}</h2>
    <dl class="space-y-4">
      {faqItems[l].map(item => (
        <div>
          <dt class="font-medium text-gray-800">{item.q}</dt>
          <dd class="mt-1 text-gray-600 text-sm">{item.a}</dd>
        </div>
      ))}
    </dl>
  </section>
</PageLayout>
