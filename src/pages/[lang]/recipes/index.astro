---
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import IddsiLevelBadge from '../../../components/IddsiLevelBadge.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'zh-hk' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params;
const isZh = lang === 'zh-hk';

const allRecipes = await getCollection('recipes', ({ data }) => data.lang === lang);
allRecipes.sort((a, b) => a.data.iddsi_level - b.data.iddsi_level);

const title = isZh
  ? '照護食食譜庫 | IDDSI Level 4-6 食譜 — softmeal.org'
  : 'Care Food Recipe Library | IDDSI Level 4-6 Recipes — softmeal.org';
const description = isZh
  ? '超過10個按 IDDSI 級別分類的照護食食譜，用香港常見食材，適合吞嚥困難長者。免費閱覽。'
  : 'Over 10 care food recipes categorised by IDDSI level, using common ingredients. Free to read. Suitable for elderly with dysphagia.';

const siteUrl = 'https://softmeal.org';
// Both zh-hk and en recipes index exist (see getStaticPaths above).
const LOCALE_BCP47_REC: Record<string, string> = { 'zh-hk': 'zh-HK', 'en': 'en' };
const hreflangLinks = [
  ...Object.entries(LOCALE_BCP47_REC).map(([locale, bcp47]) => ({
    hreflang: bcp47,
    href: `${siteUrl}/${locale}/recipes/`,
  })),
  { hreflang: 'x-default', href: `${siteUrl}/zh-hk/recipes/` },
];
---

<PageLayout
  title={title}
  description={description}
  lang={lang}
  hreflangLinks={hreflangLinks}
>
  <h1>{isZh ? '食譜庫' : 'Recipe Library'}</h1>
  <p>{isZh
    ? '以下食譜均按 IDDSI 級別分類，由低至高排列。每個食譜均包含材料、做法及叉子壓力測試結果。'
    : 'Recipes below are categorised by IDDSI level, sorted from lowest to highest. Each recipe includes ingredients, method, and fork pressure test results.'
  }</p>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
    {allRecipes.map(recipe => {
      const parts = recipe.id.split('/');
      const slug = parts[parts.length - 1].replace(/\.mdx?$/, '');
      return (
        <a
          href={`/${lang}/recipes/${slug}/`}
          class="block border border-gray-200 rounded-lg p-4 hover:border-primary hover:shadow-md transition-all no-underline"
        >
          <div class="flex items-start justify-between mb-2">
            <IddsiLevelBadge level={recipe.data.iddsi_level} />
            <span class="text-xs text-gray-500">
              {recipe.data.prep_time_minutes}{isZh ? '分鐘' : 'min'}
            </span>
          </div>
          <h2 class="text-base font-semibold text-gray-800 mt-2 mb-1">{recipe.data.title}</h2>
          <p class="text-sm text-gray-600 line-clamp-2">{recipe.data.description}</p>
        </a>
      );
    })}
  </div>

  <div class="mt-8 p-4 bg-yellow-50 border border-yellow-200 rounded text-sm text-yellow-800">
    {isZh
      ? '⚠️ 所有食譜均需由言語治療師評估後確認適合的 IDDSI 級別。食物質感因廚師技術及食材而異。'
      : '⚠️ All recipes require a speech therapist to confirm the appropriate IDDSI level for each individual. Texture varies by technique and ingredients.'}
  </div>
</PageLayout>
