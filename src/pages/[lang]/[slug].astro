  "@type": "HowTo",
  "name": lang === 'zh-hk' ? "中風後吞嚥困難患者由出院到穩定家居飲食的步驟指引" : "Steps from Hospital Discharge to Stable Home Diet for Post-Stroke Dysphagia",
  "description": lang === 'zh-hk' ? "從出院前準備到建立穩定家居改良質感飲食的完整步驟" : "Complete step-by-step guide from pre-discharge preparation to establishing a stable home modified texture diet",
  "inLanguage": lang === 'zh-hk' ? 'zh-HK' : 'en',
  "step": [
    { "@type": "HowToStep", "position": 1, "name": lang === 'zh-hk' ? "出院前確認 IDDSI 等級及書面飲食建議書" : "Confirm IDDSI levels and obtain written diet prescription before discharge", "text": lang === 'zh-hk' ? "向言語治療師確認食物及液體的 IDDSI 等級，取得書面吞嚥困難飲食建議書，包括增稠劑類型、份量及進食姿勢要求。" : "Confirm food texture and drink thickness IDDSI levels with the SLP. Obtain a written Dysphagia Diet Prescription including thickener type, dose and posture requirements." },
    { "@type": "HowToStep", "position": 2, "name": lang === 'zh-hk' ? "確認出院後言語治療跟進預約" : "Confirm post-discharge speech therapy follow-up appointment", "text": lang === 'zh-hk' ? "在離開醫院前確保已獲得門診言語治療或老人科日間醫院的跟進預約單，並確認預約日期及地點。" : "Before leaving hospital, confirm an outpatient speech therapy or Geriatric Day Hospital follow-up appointment and obtain the appointment slip with date and location." },
    { "@type": "HowToStep", "position": 3, "name": lang === 'zh-hk' ? "照顧者接受實際操作培訓" : "Caregiver receives hands-on training", "text": lang === 'zh-hk' ? "照顧者在出院前接受言語治療師培訓，內容涵蓋增稠劑稱量及混合、針筒流量測試、進食姿勢調整及危險徵象識別。" : "Caregiver receives SLP training before discharge covering thickener weighing and mixing, syringe flow test, posture adjustment, and recognition of warning signs requiring urgent attention." },
    { "@type": "HowToStep", "position": 4, "name": lang === 'zh-hk' ? "建立家居每日膳食及液體監察記錄" : "Establish home daily meal and fluid monitoring record", "text": lang === 'zh-hk' ? "每日記錄食物及液體攝取量，注意任何食量下降、嗆咳增加或體重變化，並在每次言語治療覆診時帶備記錄。" : "Keep a daily log of food and fluid intake. Note any reduction in intake, increased choking episodes or weight changes, and bring the record to every SLP follow-up appointment." }
  ]
} : null;

const howToSchemaCancerDysphagia = slug === 'cancer-treatment-dysphagia' ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": lang === 'zh-hk' ? "頭頸癌治療後飲食康復的分階段步驟" : "Staged Diet Recovery After Head and Neck Cancer Treatment",
  "description": lang === 'zh-hk' ? "從急性毒性期到長期康復的飲食管理步驟指引" : "Step-by-step guide from acute toxicity phase dietary management to long-term swallowing rehabilitation",
  "inLanguage": lang === 'zh-hk' ? 'zh-HK' : 'en',
  "step": [
    { "@type": "HowToStep", "position": 1, "name": lang === 'zh-hk' ? "治療前取得吞嚥功能基線評估" : "Obtain baseline swallowing assessment before treatment", "text": lang === 'zh-hk' ? "在放射治療開始前，由腫瘤科轉介言語治療師進行基線吞嚥功能評估，記錄目前的吞嚥功能及 IDDSI 等級，並開始預防性吞嚥運動訓練。" : "Before radiotherapy begins, request SLP referral from the oncologist for a baseline swallowing assessment. Document current swallowing function and IDDSI level, and begin prophylactic swallowing exercises." },
    { "@type": "HowToStep", "position": 2, "name": lang === 'zh-hk' ? "急性毒性期（治療期間）：選用冷軟流質及糊狀食物" : "Acute toxicity phase (during treatment): use cold soft liquids and purées", "text": lang === 'zh-hk' ? "口腔黏膜炎及吞嚥疼痛高峰期，以冷或室溫的流質及 IDDSI Level 4 糊狀食物為主，在止痛藥效時段進食，少食多餐，必要時暫時使用鼻胃管補充營養。" : "During peak mucositis and odynophagia, prioritise cold or room-temperature liquids and IDDSI Level 4 puréed foods. Time meals to coincide with analgesic effect; eat small, frequent meals; use nasogastric tube supplementation if oral intake is inadequate." },
    { "@type": "HowToStep", "position": 3, "name": lang === 'zh-hk' ? "治療後即時期：開始吞嚥康復運動" : "Immediate post-treatment period: commence swallowing rehabilitation exercises", "text": lang === 'zh-hk' ? "治療完成後盡早（在言語治療師指導下）開始 Shaker 運動、Masako 手法及張口訓練，同時維持足夠的液體及高能量軟質飲食。" : "As soon as practicable after treatment completion (under SLP guidance), begin Shaker exercises, Masako manoeuvre and jaw-opening exercises. Maintain adequate fluid intake and a high-calorie soft diet concurrently." },
    { "@type": "HowToStep", "position": 4, "name": lang === 'zh-hk' ? "治療後 3–6 個月：首次 VFSS 評估及飲食等級調整" : "3–6 months post-treatment: first VFSS assessment and diet level adjustment", "text": lang === 'zh-hk' ? "安排吞鋇造影（VFSS）客觀評估當前吞嚥功能，根據結果調整 IDDSI 等級，制定後續的飲食進階計劃及吞嚥運動強度。" : "Arrange VFSS to objectively assess current swallowing function. Based on results, adjust the IDDSI diet level and plan the subsequent diet progression schedule and swallowing exercise intensity." },
    { "@type": "HowToStep", "position": 5, "name": lang === 'zh-hk' ? "長期監察：每年 VFSS 及晚期纖維化的識別" : "Long-term monitoring: annual VFSS and identification of late fibrosis", "text": lang === 'zh-hk' ? "至少每年進行一次 VFSS 評估，並告知言語治療師任何吞嚥功能的主觀變化。晚期放射性纖維化可在治療完成後數年才顯現，持續的年度評估是識別早期惡化的關鍵。" : "Undergo at minimum annual VFSS assessment and promptly report any subjective change in swallowing to the SLP. Late radiation fibrosis can appear years after treatment completion — annual monitoring is the key to detecting early deterioration before it reaches crisis level." }
  ]
} : null;

const howToSchemaSltReports = slug === 'understanding-slt-reports' ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": lang === 'zh-hk' ? "收到言語治療師吞嚥評估報告後的跟進步驟" : "Steps to Take After Receiving a Speech Therapy Swallowing Assessment Report",
  "description": lang === 'zh-hk' ? "從閱讀報告到正確執行飲食建議及安排覆查的完整步驟" : "From reading the report to implementing dietary recommendations and arranging follow-up assessment",
  "inLanguage": lang === 'zh-hk' ? 'zh-HK' : 'en',
  "step": [
    { "@type": "HowToStep", "position": 1, "name": lang === 'zh-hk' ? "閱讀報告並識別關鍵發現" : "Read the report and identify key findings", "text": lang === 'zh-hk' ? "仔細閱讀報告，找出以下關鍵資訊：IDDSI 食物等級及飲品等級（兩者可能不同）；是否有穿透或誤吸記錄；是否確認沉默式誤吸；建議使用哪些代償策略；復康潛能評估結果。" : "Read the report carefully and identify: the recommended IDDSI food level and drink level (these may differ); whether penetration or aspiration is documented; whether silent aspiration is confirmed; which compensatory strategies are recommended; and the rehabilitation potential assessment." },
    { "@type": "HowToStep", "position": 2, "name": lang === 'zh-hk' ? "按照 IDDSI 等級調整患者的所有食物和飲品" : "Adjust all food and drinks to the recommended IDDSI level", "text": lang === 'zh-hk' ? "立即按照報告中的 IDDSI 等級調整患者的所有飲食，包括正餐、點心及所有液體。如不清楚如何製作某個等級的食物，可向言語治療師或護士索取食物製備指引。不應等到下次覆診才開始執行。" : "Immediately adjust all food and drinks to the IDDSI levels specified in the report — this applies to all meals, snacks and liquids. If you are unsure how to prepare food at a particular level, ask the SLP or nurse for food preparation guidance. Do not wait until the next appointment to begin." },
    { "@type": "HowToStep", "position": 3, "name": lang === 'zh-hk' ? "在每次進食時執行報告建議的代償策略" : "Implement the recommended compensatory strategies at every meal", "text": lang === 'zh-hk' ? "確認報告中指定的代償策略（如下巴內收、頭部轉側、用力吞嚥等），並在每次進食時一貫執行，不可選擇性跳過。如不確定策略的正確操作方式，在下次言語治療師覆診時要求示範。" : "Identify the compensatory strategies specified in the report (such as chin tuck, head rotation, effortful swallow) and apply them consistently at every single meal — they must not be selectively skipped. If you are unsure of the correct technique, request a demonstration at the next SLP appointment." },
    { "@type": "HowToStep", "position": 4, "name": lang === 'zh-hk' ? "在覆診時準備具體問題" : "Prepare specific questions for the follow-up appointment", "text": lang === 'zh-hk' ? "記錄患者在實際進食中的觀察（如哪些食物引起嗆咳、進食時間長短、體重變化），在覆診時告知言語治療師。詢問是否需要儀器評估（VFSS 或 FEES）、下次覆查的時間，以及在什麼情況下應提前尋求緊急評估。" : "Keep a log of observations during actual meals (which foods cause coughing, how long meals take, weight changes) and report these to the SLP at the next appointment. Ask whether instrumental assessment (VFSS or FEES) is indicated, when the next review should be scheduled, and under what circumstances you should seek urgent reassessment." },
    { "@type": "HowToStep", "position": 5, "name": lang === 'zh-hk' ? "若出現新症狀立即聯繫醫療團隊" : "Contact the medical team immediately if new symptoms develop", "text": lang === 'zh-hk' ? "以下情況應立即聯絡主診醫生或言語治療師，而非等待下次預約：患者出現發燒超過 38°C（可能是吸入性肺炎）；吞嚥突然明顯惡化；患者在進食時面色發青或呼吸困難（致電 999）；體重在兩週內下降超過 2kg。" : "Contact the attending doctor or SLP immediately — do not wait for the next appointment — if: the patient develops fever above 38°C (possible aspiration pneumonia); swallowing suddenly deteriorates markedly; the patient turns blue or has breathing difficulty during meals (call 999); or weight drops more than 2 kg within two weeks." }
  ]
} : null;

const howToSchemaTextureMod = slug === 'food-texture-modification-basics' ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": lang === 'zh-hk' ? "按 IDDSI 等級在家製備改良食物的步驟" : "Step-by-Step Home Food Texture Modification by IDDSI Level",
  "description": lang === 'zh-hk' ? "從確認 IDDSI 等級到製備、測試及安全上桌的完整步驟" : "Complete process from confirming IDDSI level to preparation, testing and safe serving",
  "inLanguage": lang === 'zh-hk' ? 'zh-HK' : 'en',
  "step": [
    { "@type": "HowToStep", "position": 1, "name": lang === 'zh-hk' ? "確認言語治療師指定的 IDDSI 食物等級及飲品等級" : "Confirm the SLP-prescribed IDDSI food level and drink level", "text": lang === 'zh-hk' ? "從言語治療師的評估報告或書面飲食建議書中確認食物等級（Level 3–7）及飲品等級（Level 0–4）。兩者可能不同。如有疑問，在開始製備前聯絡言語治療師確認。" : "From the SLP's assessment report or written Dysphagia Diet Prescription, confirm the food level (Level 3–7) and drink level (Level 0–4). These may differ. If in doubt, contact the SLP to confirm before beginning preparation." },
    { "@type": "HowToStep", "position": 2, "name": lang === 'zh-hk' ? "選擇合適的食材並烹煮至足夠軟熟" : "Select appropriate ingredients and cook until sufficiently soft", "text": lang === 'zh-hk' ? "選用天然質地較軟的食材（豆腐、南瓜、魚類、蛋）；避免纖維粗韌、黏韌或圓形細小的食材。烹煮時間要比一般標準延長，確保食材徹底熟透且可用叉子輕易壓碎。" : "Choose naturally softer ingredients (tofu, pumpkin, fish, eggs); avoid fibrous, sticky or small round foods. Cook for longer than standard to ensure ingredients are thoroughly soft and can be easily mashed with a fork." },
    { "@type": "HowToStep", "position": 3, "name": lang === 'zh-hk' ? "按目標等級處理食物" : "Process food to the target level", "text": lang === 'zh-hk' ? "Level 4（糊狀）：加入少量高湯後以攪拌機徹底攪打，再過細目篩確保無顆粒。Level 5（細碎濕潤）：切碎至 4mm 以下，加醬汁保持濕潤。Level 6（軟質切小塊）：切成 15mm 以下的均勻小塊，確保質地夠軟。增稠飲品：按電子磅量度增稠劑份量，充分攪拌後靜待 1–2 分鐘讓稠度穩定。" : "Level 4 (Puréed): add a little stock, blend thoroughly, then sieve through a fine-mesh sieve to eliminate all particles. Level 5 (Minced & Moist): cut into pieces smaller than 4 mm, add sauce to maintain moisture. Level 6 (Soft & Bite-Sized): cut into uniform pieces smaller than 15 mm, ensure texture is soft throughout. Thickened drinks: weigh thickener precisely using a digital scale, stir thoroughly and wait 1–2 minutes for consistency to stabilise." },
    { "@type": "HowToStep", "position": 4, "name": lang === 'zh-hk' ? "進行質感測試確認達到目標等級" : "Perform texture testing to confirm the target level is achieved", "text": lang === 'zh-hk' ? "叉子壓力測試（Level 4–6）：用叉背施加約 140g 壓力。Level 4 完全攤平不回彈；Level 5 壓縮但不壓平；Level 6 抵抗壓力但叉側可切開。飲品稠度測試：使用 10ml 針筒進行 IDDSI 流量測試。如未達到目標等級，調整並重新測試。" : "Fork pressure test (Levels 4–6): press with the back of a fork at approximately 140 g. Level 4 flattens completely and does not spring back; Level 5 compresses but does not flatten; Level 6 resists but can be cut by the fork side. Drink thickness: use a 10 ml syringe for the IDDSI flow test. If the target level is not met, adjust and re-test before serving." },
    { "@type": "HowToStep", "position": 5, "name": lang === 'zh-hk' ? "安全上桌並監察進食過程" : "Serve safely and monitor during eating", "text": lang === 'zh-hk' ? "確保患者保持 90° 坐姿，頭部略前傾。每口份量不超過一茶匙；每口之間等待患者完全吞下再繼續。執行言語治療師指定的代償策略（如下巴內收、頭部轉側）。進食後讓患者保持坐姿至少 30 分鐘。注意進食時或進食後出現的咳嗽或聲音變化。" : "Ensure the patient is seated upright at 90°, with head slightly forward. Offer no more than one teaspoon per mouthful; wait for complete swallowing before the next mouthful. Apply the compensatory strategies specified by the SLP (e.g. chin tuck, head rotation). Keep the patient upright for at least 30 minutes after eating. Monitor for coughing or voice changes during or immediately after the meal." }
  ]
} : null;

const howToSchemaKitchenSetup = slug === 'home-kitchen-setup-hk' ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": lang === 'zh-hk' ? "如何為吞嚥困難患者設置家居廚房" : "How to Set Up a Dysphagia-Friendly Kitchen at Home",
  "description": lang === 'zh-hk' ? "從選購攪拌機到適應性餐具及廚房安全的完整設置步驟" : "Complete steps from blender selection to adaptive utensils and kitchen safety",
  "inLanguage": lang === 'zh-hk' ? 'zh-HK' : 'en',
  "tool": [
    {"@type": "HowToTool", "name": lang === 'zh-hk' ? "攪拌機（1000W+，濕式刀頭）" : "Blender (1000W+, wet blade)"},
    {"@type": "HowToTool", "name": lang === 'zh-hk' ? "電子磅（精確至 1g）" : "Digital kitchen scale (1g precision)"},
    {"@type": "HowToTool", "name": lang === 'zh-hk' ? "細目不鏽鋼篩網" : "Fine-mesh stainless steel sieve"}
  ],
  "step": [
    {"@type": "HowToStep", "position": 1, "name": lang === 'zh-hk' ? "選購攪拌機" : "Select a blender", "text": lang === 'zh-hk' ? "選購 1000W 或以上功率、濕式刀頭的攪拌機，確保刀頭可完全拆解清洗。香港豐澤、蘇寧或 HKTVmall 均有選購，參考價格 HKD $500–$3,000。" : "Choose a blender with 1000W or above and a wet blade design, ensuring the blade assembly is fully detachable for cleaning. Available at Broadway, Suning or HKTVmall in Hong Kong; approximate price HKD $500–$3,000."},
    {"@type": "HowToStep", "position": 2, "name": lang === 'zh-hk' ? "準備基本輔助器材" : "Acquire basic assistive utensils", "text": lang === 'zh-hk' ? "購置缺口杯（深水埗醫療用品店，HKD $30–80）、角度匙（HKD $50–150）、碗碟護邊（HKD $30–60）及防滑餐墊（超市，HKD $20–50）。" : "Purchase a cut-out cup (Sham Shui Po medical shops, HKD $30–80), angled spoon (HKD $50–150), plate guard (HKD $30–60) and non-slip dining mat (supermarkets, HKD $20–50)."},
    {"@type": "HowToStep", "position": 3, "name": lang === 'zh-hk' ? "備置增稠劑存量" : "Stock an adequate thickener supply", "text": lang === 'zh-hk' ? "確保儲備至少 2–4 週的增稠劑。切勿中途更換增稠劑品牌，以免稠度不一致影響患者安全。每次使用前以電子磅準確量度份量。" : "Stock at least 2–4 weeks of thickener. Avoid switching brands mid-use to prevent inconsistent consistency levels. Always measure with a digital scale rather than estimating by volume."},
    {"@type": "HowToStep", "position": 4, "name": lang === 'zh-hk' ? "建立廚房安全及清潔制度" : "Establish kitchen safety and cleaning routines", "text": lang === 'zh-hk' ? "每次使用後立即拆開攪拌機刀頭清洗，每週消毒一次。所有食物上桌前確認溫度（40–55°C），並重新進行 IDDSI 質感測試。" : "After every use, fully disassemble and clean the blender blade assembly; sterilise weekly. Before serving, confirm food temperature (40–55°C) and re-test IDDSI texture after any heating or refrigeration."}
  ]
} : null;

const howToSchemaSwallowingExercises = slug === 'swallowing-exercises-hk' ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": lang === 'zh-hk' ? "如何進行 Shaker 頭部提升運動（吞嚥訓練）" : "How to Perform the Shaker Head Lift Exercise for Swallowing Rehabilitation",
  "description": lang === 'zh-hk' ? "在言語治療師指導下進行 Shaker 運動的分步指引" : "Step-by-step guide to the Shaker head lift exercise under speech therapist guidance",
  "inLanguage": lang === 'zh-hk' ? 'zh-HK' : 'en',
  "step": [
    {"@type": "HowToStep", "position": 1, "name": lang === 'zh-hk' ? "確認適合性（必須先諮詢言語治療師）" : "Confirm suitability (SLP assessment required first)", "text": lang === 'zh-hk' ? "Shaker 運動並非適合所有患者。頸椎問題患者禁止進行。必須先由言語治療師評估確認適合後才開始。" : "The Shaker exercise is not appropriate for all patients. Patients with cervical spine problems must not perform this exercise. Suitability must be confirmed by an SLP assessment before starting."},
    {"@type": "HowToStep", "position": 2, "name": lang === 'zh-hk' ? "採取正確起始姿勢" : "Adopt the correct starting position", "text": lang === 'zh-hk' ? "患者平躺在床上或地板上（仰臥位），雙肩平放，不離開床面。頸部放鬆，不緊繃。" : "Lie flat on a bed or floor (supine position), both shoulders flat and not raised. Neck should be relaxed, not tense."},
    {"@type": "HowToStep", "position": 3, "name": lang === 'zh-hk' ? "進行等長收縮（靜態保持）" : "Perform isometric holds (static)", "text": lang === 'zh-hk' ? "緩緩抬起頭部，嘗試用眼睛望向自己的腳趾，保持肩膀不離開床面。保持頭部抬起位置 60 秒，重複 3 次，每次中間休息。" : "Slowly raise the head as if trying to see your toes, keeping the shoulders flat. Hold the raised position for 60 seconds, repeat 3 times with rest between each hold."},
    {"@type": "HowToStep", "position": 4, "name": lang === 'zh-hk' ? "進行等張收縮（動態重複）" : "Perform isotonic repetitions (dynamic)", "text": lang === 'zh-hk' ? "完成靜態保持後，快速抬頭及放頭，連續重複 30 次。整個過程保持肩膀不離開床面。" : "Following the static holds, raise and lower the head in rapid succession, 30 repetitions. Keep shoulders flat throughout."},
    {"@type": "HowToStep", "position": 5, "name": lang === 'zh-hk' ? "記錄完成情況並告知言語治療師" : "Record completion and report to SLP", "text": lang === 'zh-hk' ? "每日進行 3 組（靜態 + 動態），持續 6 週。若出現頸痛、頭痛或任何不適，立即停止並告知言語治療師。定期複診讓言語治療師評估進展。" : "Complete 3 sets daily (static + dynamic) for 6 weeks. Stop immediately and inform the SLP if neck pain, headache or any discomfort occurs. Regular SLP reviews are essential to assess progress."}
  ]
} : null;

const howToSchema = howToSchemaIddsi ?? howToSchemaDischarge ?? howToSchemaProfessionals ?? howToSchemaTubeTransition ?? howToSchemaCareHome ?? howToSchemaSpeechReferral ?? howToSchemaPostStroke ?? howToSchemaCancerDysphagia ?? howToSchemaSltReports ?? howToSchemaTextureMod ?? howToSchemaKitchenSetup ?? howToSchemaSwallowingExercises ?? null;

// BreadcrumbList schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "inLanguage": lang === 'zh-hk' ? 'zh-HK' : 'en',
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": lang === 'zh-hk' ? "主頁" : "Home", "item": `https://softmeal.org/${lang}/`},
    {"@type": "ListItem", "position": 2, "name": title, "item": `https://softmeal.org/${lang}/${slug}/`}
  ]
};

const schemas = [
  ...(articleSchema ? [articleSchema] : []),
  ...(faqSchema ? [faqSchema] : []),
  ...(howToSchema ? [howToSchema] : []),
  breadcrumbSchema,
];
---

<PageLayout
  title={title}
  description={description}
  lang={lang}
  hreflangPair={hreflang_pair}
  hreflangPairLang={hreflangPairLang}
  schemaJson={schemas}
>
  <Content />
</PageLayout>
