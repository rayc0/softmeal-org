const faqKitchenSetupEn = [
  { "@type": "Question", "name": "What blender power is recommended for a dysphagia care kitchen?", "acceptedAnswer": { "@type": "Answer", "text": "Minimum 1000W or above, with a wet blade design. An underpowered blender cannot process meat and fibrous vegetables to the particle-free smoothness required for IDDSI Level 4 Puréed — a genuine patient safety risk. Broadway, Suning and HKTVmall in Hong Kong carry suitable options; home blenders range from approximately HKD $500–$3,000." } },
  { "@type": "Question", "name": "Where can I buy a cut-out cup in Hong Kong?", "acceptedAnswer": { "@type": "Answer", "text": "Cut-out cups are available at medical supply shops along Kweilin Street and Apliu Street in Sham Shui Po, and on HKTVmall (search 'cut-out cup' or '缺口杯'). Approximate price: HKD $30–80. The cut-out allows the patient to drink without tilting the head back, maintaining the chin-tuck position that reduces aspiration risk." } },
  { "@type": "Question", "name": "How should a blender be sterilised to prevent cross-contamination?", "acceptedAnswer": { "@type": "Answer", "text": "After every use, fully disassemble the blade unit, wash all components with hot water and dish soap, and air-dry completely before reassembling. Weekly: soak in boiled water or diluted bleach. Never rinse only the outer jar without disassembling the blade — food residue in the crevices creates an infection risk for patients with compromised immunity." } },
  { "@type": "Question", "name": "How do food moulds improve willingness to eat for dysphagia patients?", "acceptedAnswer": { "@type": "Answer", "text": "IDDSI food moulds press puréed food into the shape of the original dish (fish, chicken leg, etc.), restoring visual appeal. Clinical observation consistently shows visual presentation significantly improves a patient's willingness to eat, particularly in patients with dementia. Silicone food moulds are available on HKTVmall; approximate price: HKD $80–250." } }
