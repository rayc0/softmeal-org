  { "@type": "Question", "name": "How long are the typical waiting times for public hospital speech therapy in Hong Kong?", "acceptedAnswer": { "@type": "Answer", "text": "Waiting times vary significantly by cluster and priority category. Acute inpatient cases are typically seen within days to one week. Stable outpatient cases referred after discharge range from several weeks to six months or more. Geriatric Day Hospitals generally have shorter waits than general specialist outpatient clinics. Patients with high-risk indicators such as recurrent aspiration pneumonia or significant weight loss are prioritised." } },
  { "@type": "Question", "name": "How much do private speech-language pathologists charge in Hong Kong?", "acceptedAnswer": { "@type": "Answer", "text": "Initial assessment (including IDDSI level evaluation and written prescription) is approximately HKD 1,200–2,500. Follow-up therapy sessions (45–60 minutes) range from HKD 800–1,800. Outreach or care home visits cost approximately HKD 1,500–3,000 depending on location and session length. Find qualified registered practitioners through the HKSLTA directory at hkslta.org.hk." } },
  { "@type": "Question", "name": "How do I arrange FEES or VFSS swallowing assessment at a Hong Kong public hospital?", "acceptedAnswer": { "@type": "Answer", "text": "FEES (fibreoptic endoscopic evaluation of swallowing) is arranged by the SLP or ENT doctor; the SLP typically recommends it and coordinates with the relevant department after clinical assessment. VFSS (videofluoroscopic swallowing study) requires a referral from the attending doctor — the SLP advises and asks the doctor to issue the referral to radiology. Both assessments are covered under standard HA fees for eligible public patients." } },
  { "@type": "Question", "name": "When should a patient in Hong Kong consider going private rather than waiting for public speech therapy?", "acceptedAnswer": { "@type": "Answer", "text": "Consider private services when: urgent reassessment is needed after discharge while awaiting public outpatient; intensive therapy (multiple sessions per week) is required but public resources are limited; outreach to a care home is needed (public hospitals do not provide this); or the waiting period is compromising the patient's safety or nutritional status. Private appointments are typically available within days to weeks. Ask about insurance coverage or Community Care Service Voucher eligibility." } }
];

