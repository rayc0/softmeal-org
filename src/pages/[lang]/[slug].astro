const faqFinancialZhHk = [
  { "@type": "Question", "name": "增稠劑費用可以透過哪些香港政府計劃補貼？", "acceptedAnswer": { "@type": "Answer", "text": "主要途徑包括：CSSA 特別飲食津貼（需主診醫生或言語治療師醫療證明）、社區照顧基金（視乎當期計劃範圍）及部分非政府機構援助。公立醫院在出院後的跟進期間，部分增稠劑可由醫院配發（視乎個案及醫院政策）。建議向醫務社工（MSW）查詢最新可申請途徑。" } },
  { "@type": "Question", "name": "傷殘津貼和長者生活津貼可以同時領取嗎？", "acceptedAnswer": { "@type": "Answer", "text": "一般而言，傷殘津貼與長者生活津貼不可同時領取。65 歲以上且符合殘疾資格的長者可選擇申請金額較高的一種。醫務社工可協助比較哪種補貼對個別患者更有利。查詢可致電社署熱線 2343 2255。" } },
  { "@type": "Question", "name": "吞嚥困難患者的住院費用是否受香港保險保障？", "acceptedAnswer": { "@type": "Answer", "text": "因中風、癌症治療或術後康復而住院期間出現吞嚥困難的相關費用，通常可以向住院保險索償。危疾保險若因中風、ALS 等涵蓋疾病觸發賠償，賠償金可用於支付長期吞嚥照護費用。吞嚥困難本身不是危疾保險的獨立受保病種。" } },
  { "@type": "Question", "name": "醫務社工如何協助吞嚥困難照顧者獲取財務支援？", "acceptedAnswer": { "@type": "Answer", "text": "醫管局公立醫院的醫務社工（MSW）可評估患者及家庭的財務狀況，推薦最適合的資助計劃，協助填寫申請文件，以及協調跨部門轉介（社署、非政府機構、醫院）。出院時、覆診時或直接致電醫院醫務社工部均可要求轉介，是獲取財務支援的最重要第一步。" } }
];
const faqFinancialEn = [
  { "@type": "Question", "name": "Which Hong Kong government schemes can subsidise thickener costs?", "acceptedAnswer": { "@type": "Answer", "text": "Main options: CSSA Special Diet Allowance (requires medical certificate from doctor or SLP), Community Care Fund (subject to current programme scope) and some NGO assistance schemes. Some public hospitals supply thickeners during post-discharge follow-up (policy varies). Ask your Medical Social Worker (MSW) for the latest available options. SWD hotline: 2343 2255." } },
  { "@type": "Question", "name": "Can Disability Allowance and Old Age Living Allowance be claimed at the same time in Hong Kong?", "acceptedAnswer": { "@type": "Answer", "text": "Generally, the two allowances cannot be claimed simultaneously. Elderly patients aged 65 or above who qualify for both may choose whichever provides the higher amount. A medical social worker can compare which benefit is more advantageous for the individual. Contact the SWD hotline at 2343 2255 for enquiries." } },
  { "@type": "Question", "name": "Does Hong Kong insurance cover hospitalisation costs related to dysphagia?", "acceptedAnswer": { "@type": "Answer", "text": "Hospitalisation costs where dysphagia arises from acute stroke, cancer treatment or post-surgical recovery are typically covered under hospitalisation insurance policies. Critical illness payouts triggered by covered conditions (stroke, ALS, etc.) can fund ongoing dysphagia care including thickeners and private SLP. Dysphagia itself is not a standalone covered condition under critical illness policies." } },
  { "@type": "Question", "name": "How can a medical social worker help dysphagia caregivers access financial support?", "acceptedAnswer": { "@type": "Answer", "text": "MSWs at all HA public hospitals can assess financial circumstances, recommend the most appropriate support schemes, assist with application forms and documentation, and coordinate multi-agency referrals (SWD, NGOs, hospital departments). Request a referral at discharge, at a follow-up appointment, or by calling the hospital's Medical Social Services department. This is the most efficient first step into Hong Kong's support system." } }
];

const faqSwallowingExercisesZhHk = [
  { "@type": "Question", "name": "在沒有言語治療師指導下自行進行吞嚥訓練運動安全嗎？", "acceptedAnswer": { "@type": "Answer", "text": "不安全。不恰當的吞嚥訓練（例如頸椎問題患者進行 Shaker 運動）可造成傷害。吞嚥訓練必須在言語治療師評估後，根據個別患者情況選擇合適的運動類型、頻率及強度。患者可在 HKSLTA 名冊（hkslta.org.hk）搜尋香港認證言語治療師。" } },
  { "@type": "Question", "name": "Masako 策略可以在進食時使用嗎？", "acceptedAnswer": { "@type": "Answer", "text": "不可以。Masako 策略（舌持吞嚥）只是訓練運動，不應在實際進食時使用。進食時採用此策略會因舌頭活動受限而增加誤吸風險。是否適合在進食時採用任何代償策略，必須由言語治療師個別評估決定。" } },
  { "@type": "Question", "name": "吞嚥訓練運動需要進行多長時間才有效？", "acceptedAnswer": { "@type": "Answer", "text": "訓練效果因運動類型、患者病情及依從性而異。原始 Shaker 運動研究方案為每日 3 次、持續 6 週。其他運動的時間長度由言語治療師根據定期評估結果決定。不應自行停止訓練——應在言語治療師確認功能已穩定達到治療目標後才減少頻率。" } }
];
const faqSwallowingExercisesEn = [
  { "@type": "Question", "name": "Is it safe to perform swallowing exercises without speech therapist guidance?", "acceptedAnswer": { "@type": "Answer", "text": "No. Inappropriate swallowing exercises — such as Shaker exercises in a patient with cervical spine problems — can cause harm. Swallowing exercises must be selected, prescribed and supervised by a speech-language pathologist based on individual assessment. Search the HKSLTA directory at hkslta.org.hk to find a certified SLP in Hong Kong." } },
  { "@type": "Question", "name": "Can the Masako Manoeuvre be used during actual meals?", "acceptedAnswer": { "@type": "Answer", "text": "No. The Masako Manoeuvre (tongue-hold swallow) is a training exercise only and should not be used at mealtimes. Applying it during eating restricts tongue mobility, impairing its normal role in propelling the food bolus and increasing aspiration risk. Whether any compensatory strategy is appropriate during meals must be determined by individual SLP assessment." } },
