const faqProfessionalsEn = [
  {
    "@type": "Question",
    "name": "Can a nurse or caregiver determine a patient's IDDSI level without a formal SLP assessment?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "No. IDDSI level prescription must be made by a trained speech-language pathologist following clinical assessment. Silent aspiration can occur without any cough reflex or visible choking, making observational assessment of mealtime behaviour unreliable. Nurses and caregivers implement the plan prescribed by the SLP and monitor for warning signs — they do not prescribe diet levels."
    }
  },
  {
    "@type": "Question",
    "name": "Can the patient upgrade their own IDDSI level at home?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "This should not happen without a formal SLP reassessment. Even when a patient subjectively feels they are swallowing better, silent aspiration can persist without visible symptoms. Any level upgrade requires a clinical evaluation."
    }
  },
  {
    "@type": "Question",
    "name": "Are Hong Kong care homes legally required to follow IDDSI standards?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "Current Hong Kong legislation (Code of Practice for Residential Care Homes) does not specifically mandate IDDSI levels. However, the HKCSS Care Food Endorsement Scheme has become the de facto industry benchmark. Using IDDSI documentation and maintaining complete dietary records substantially reduces the legal and reputational risk to care homes in the event of adverse incidents."
    }
  },
  {
    "@type": "Question",
    "name": "How can a care home kitchen implement IDDSI testing on a limited budget?",
    "acceptedAnswer": {
      "@type": "Answer",
      "text": "The minimum-cost approach: purchase 10ml syringes from a pharmacy (approximately HKD 5 each) for the flow test; use existing dining forks for the pressure test; download IDDSI's free testing cards from iddsi.net. Consistent testing discipline matters more than expensive equipment — test every new food batch and record results."
    }
  }
];

const newGuideSlugs = ['yum-cha-guide', 'hospital-discharge-planning', 'thickener-comparison-hk', 'elderly-nutrition-hk', 'for-professionals'];

const getFaqMainEntity = () => {
  if (slug === 'yum-cha-guide') return lang === 'zh-hk' ? faqYumChaZhHk : faqYumChaEn;
  if (slug === 'hospital-discharge-planning') return lang === 'zh-hk' ? faqDischargeZhHk : faqDischargeEn;
  if (slug === 'thickener-comparison-hk') return lang === 'zh-hk' ? faqThickenerZhHk : faqThickenerEn;
  if (slug === 'elderly-nutrition-hk') return lang === 'zh-hk' ? faqNutritionZhHk : faqNutritionEn;
  if (slug === 'for-professionals') return lang === 'zh-hk' ? faqProfessionalsZhHk : faqProfessionalsEn;
  return lang === 'zh-hk' ? faqQuestionsZhHk : faqQuestionsEn;
};

const faqSlugs = ['iddsi-guide', ...newGuideSlugs];
const faqSchema = faqSlugs.includes(slug) ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": getFaqMainEntity()
} : null;

// HowTo schema — injected for iddsi-guide and hospital-discharge-planning
const howToSchemaIddsi = slug === 'iddsi-guide' ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": lang === 'zh-hk' ? "如何使用叉子壓力測試驗證食物 IDDSI 等級" : "How to test food texture using the IDDSI Fork Pressure Test",
  "description": lang === 'zh-hk' ? "用標準廚房叉子驗證食物達到指定 IDDSI 等級的步驟" : "Step-by-step guide to verifying IDDSI food texture levels using a fork",
  "inLanguage": lang === 'zh-hk' ? 'zh-HK' : 'en',
  "tool": [{"@type": "HowToTool", "name": lang === 'zh-hk' ? "叉子" : "Fork"}],
  "step": [
    {"@type": "HowToStep", "position": 1, "name": lang === 'zh-hk' ? "準備食物樣本" : "Prepare food sample", "text": lang === 'zh-hk' ? "取一小份食物，確保已冷卻至室溫" : "Take a small portion of food, cooled to room temperature"},
    {"@type": "HowToStep", "position": 2, "name": lang === 'zh-hk' ? "施加叉子壓力" : "Apply fork pressure", "text": lang === 'zh-hk' ? "用叉背以約 140g（約一個小蘋果重量）的力量壓在食物上" : "Press the back of a fork with approximately 140g of pressure"},
    {"@type": "HowToStep", "position": 3, "name": lang === 'zh-hk' ? "觀察結果" : "Observe result", "text": lang === 'zh-hk' ? "Level 4：完全壓平不回彈。Level 5：壓縮但不壓平。Level 6：抵抗壓力。" : "Level 4: flattens completely. Level 5: compresses but not flat. Level 6: resists pressure."}
  ]
} : null;

const howToSchemaDischarge = slug === 'hospital-discharge-planning' ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": lang === 'zh-hk' ? "吞嚥困難患者出院後的過渡步驟" : "Steps for Transitioning a Dysphagia Patient from Hospital to Home",
  "description": lang === 'zh-hk' ? "從出院前準備、家居佈置到社區跟進的完整步驟指引" : "Complete step-by-step guide from pre-discharge preparation to community follow-up",
  "inLanguage": lang === 'zh-hk' ? 'zh-HK' : 'en',
  "step": [
    {"@type": "HowToStep", "position": 1, "name": lang === 'zh-hk' ? "出院前確認 IDDSI 等級及書面飲食建議書" : "Confirm IDDSI level and obtain written diet prescription before discharge", "text": lang === 'zh-hk' ? "向言語治療師確認食物及液體的 IDDSI 等級，並取得書面的吞嚥困難飲食建議書，包括增稠劑類型及份量指引。" : "Confirm food texture and drink thickness IDDSI levels with the SLP. Obtain a written Dysphagia Diet Prescription including thickener type and dosing instructions."},
    {"@type": "HowToStep", "position": 2, "name": lang === 'zh-hk' ? "安排出院後言語治療跟進預約" : "Arrange post-discharge speech therapy follow-up appointment", "text": lang === 'zh-hk' ? "在出院前確保已獲得門診言語治療或老人科日間醫院的跟進預約單，並確認預約日期。" : "Before leaving hospital, confirm an outpatient speech therapy or Geriatric Day Hospital follow-up appointment and obtain the appointment slip."},
    {"@type": "HowToStep", "position": 3, "name": lang === 'zh-hk' ? "準備家居廚房及器具" : "Prepare the home kitchen and equipment", "text": lang === 'zh-hk' ? "購置攪拌機、電子磅、細目篩網及小碗口湯匙，並儲備至少 2–4 週的增稠劑存量。" : "Acquire a blender, digital kitchen scale, fine-mesh sieve and small-bowled spoons. Stock at least 2–4 weeks of thickener supply."},
    {"@type": "HowToStep", "position": 4, "name": lang === 'zh-hk' ? "建立每日餐食計劃並監察攝取量" : "Establish a daily meal plan and monitor intake", "text": lang === 'zh-hk' ? "採用少食多餐（每日 5–6 餐），記錄每日進食及液體攝取量，注意任何食量下降或咳嗽增加的跡象。" : "Plan 5–6 small meals per day. Keep a daily intake log and monitor for any reduction in food intake, increased coughing or signs of fatigue."}
  ]
} : null;

const howToSchemaProfessionals = slug === 'for-professionals' ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": lang === 'zh-hk' ? "如何為吞嚥困難患者進行 IDDSI 等級評估及制定照護計劃" : "How to assess IDDSI level and develop a dysphagia care plan for a patient",
  "description": lang === 'zh-hk' ? "從初步篩查到訂定 IDDSI 飲食等級及跨專業照護計劃的完整步驟" : "Complete steps from initial screening to IDDSI diet level prescription and interdisciplinary care planning",
  "inLanguage": lang === 'zh-hk' ? 'zh-HK' : 'en',
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": lang === 'zh-hk' ? "進行初步篩查（EAT-10）" : "Conduct initial screening (EAT-10)",
      "text": lang === 'zh-hk' ? "由護士或醫生使用 EAT-10 量表進行初步篩查。總分 ≥3 分提示可能存在吞嚥困難，應轉介言語治療師作正式評估。" : "A nurse or doctor administers the EAT-10 screening tool. A total score of ≥3 suggests possible dysphagia and warrants SLP referral for formal assessment."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": lang === 'zh-hk' ? "言語治療師進行臨床吞嚥評估" : "SLP performs clinical swallowing assessment",
      "text": lang === 'zh-hk' ? "言語治療師使用標準化工具（如 MASA）評估口腔運動功能、咳嗽反射、吞嚥協調及誤吸風險，並訂定 IDDSI 食物及液體等級。" : "The SLP uses standardised tools (such as MASA) to assess oral motor function, cough reflex, swallowing coordination and aspiration risk, then prescribes IDDSI food texture and drink thickness levels."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": lang === 'zh-hk' ? "出具書面飲食建議書" : "Issue written Dysphagia Diet Prescription",
      "text": lang === 'zh-hk' ? "言語治療師出具書面飲食建議書，列明 IDDSI 等級、增稠劑種類及份量、禁止食物清單及進食姿勢建議。所有跨專業成員及照顧者應獲得一份。" : "The SLP issues a written Dysphagia Diet Prescription specifying IDDSI levels, thickener type and dose, prohibited food list, and posture recommendations. All interdisciplinary team members and caregivers should receive a copy."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "name": lang === 'zh-hk' ? "跨專業協作制定照護計劃" : "Develop interdisciplinary care plan",
      "text": lang === 'zh-hk' ? "營養師計算能量及蛋白質需求；職業治療師評估進食自主能力及輔助器具；社工安排社區服務轉介。定期跨專業會議（建議每週一次）檢討進展。" : "The dietitian calculates energy and protein requirements; the OT assesses independent eating ability and adaptive equipment; the social worker arranges community service referrals. Regular interdisciplinary meetings (weekly recommended) review progress."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "name": lang === 'zh-hk' ? "安排出院後社區跟進" : "Arrange post-discharge community follow-up",
      "text": lang === 'zh-hk' ? "出院前確認門診言語治療預約、家庭醫生跟進及社署服務（如適用）。照顧者須接受實際操作培訓，包括增稠劑使用及危禁食物識別。" : "Before discharge, confirm outpatient SLP appointment, GP follow-up and SWD services (if applicable). Caregivers must receive hands-on training covering thickener preparation and prohibited food identification."
    }
  ]
} : null;

const howToSchema = howToSchemaIddsi ?? howToSchemaDischarge ?? howToSchemaProfessionals ?? null;

// BreadcrumbList schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "inLanguage": lang === 'zh-hk' ? 'zh-HK' : 'en',
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": lang === 'zh-hk' ? "主頁" : "Home", "item": `https://softmeal.org/${lang}/`},
    {"@type": "ListItem", "position": 2, "name": title, "item": `https://softmeal.org/${lang}/${slug}/`}
  ]
};

const schemas = [
  ...(articleSchema ? [articleSchema] : []),
  ...(faqSchema ? [faqSchema] : []),
  ...(howToSchema ? [howToSchema] : []),
  breadcrumbSchema,
];
---

<PageLayout
  title={title}
  description={description}
  lang={lang}
  hreflangPair={hreflang_pair}
  hreflangPairLang={hreflangPairLang}
  schemaJson={schemas}
>
  <Content />
</PageLayout>
