const faqTextureModEn = [
  { "@type": "Question", "name": "What are the characteristics of the 8 IDDSI levels?", "acceptedAnswer": { "@type": "Answer", "text": "Level 0 (Thin) is water consistency; Levels 1–2 are lightly thickened drinks; Level 3 (Liquidised) pours from a cup; Level 4 (Puréed) is spoon-fed with no lumps; Level 5 (Minced & Moist) has maximum particle size 4 mm; Level 6 (Soft & Bite-Sized) has maximum piece size 15 mm and can be cut with the fork side; Level 7 is normal soft food. Each patient's level is determined by their speech therapist based on individual assessment." } },
  { "@type": "Question", "name": "How do I test food texture at home to confirm the correct IDDSI level?", "acceptedAnswer": { "@type": "Answer", "text": "There are three main tests: the Fork Pressure Test (for Levels 4–6) — press with the back of a fork at approximately 140 g; Level 4 flattens completely, Level 5 compresses but does not flatten, Level 6 resists. The Spoon Tilt Test (for Levels 3–4) observes whether food flows from the spoon. The Syringe Flow Test confirms drink thickness for Levels 0–4. Always test after preparation and again after refrigerating." } },
  { "@type": "Question", "name": "What are the most common mistakes in preparing modified food?", "acceptedAnswer": { "@type": "Answer", "text": "The most common errors are: not sieving after blending (fibres and particles remain); estimating thickener by eye rather than weighing; mixing foods of different textures (dual texture); not re-testing after refrigeration; and assuming all thickener brands are equivalent (concentration can differ by 50%). The most serious is Level 4 food containing any lumps — this significantly increases aspiration risk." } },
  { "@type": "Question", "name": "How can I make modified food look and taste better?", "acceptedAnswer": { "@type": "Answer", "text": "Use food moulds to press puréed food into the shape of the original dish — restoring visual form improves willingness to eat. Adapt familiar Cantonese dishes rather than switching to unfamiliar textures. Use Hong Kong ingredients that naturally achieve soft textures: pumpkin, taro, silken tofu. Plate components of different colours side by side, and finish with a small drizzle of sesame oil or grated ginger for aroma." } }
