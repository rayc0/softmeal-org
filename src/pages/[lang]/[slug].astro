    { "@type": "HowToStep", "position": 1, "name": lang === 'zh-hk' ? "由家庭醫生或普通科門診初步評估" : "Initial assessment by GP or General Outpatient Clinic (GOPC)", "text": lang === 'zh-hk' ? "若察覺吞嚥困難症狀（進食時咳嗽、食物或液體嗆入鼻腔、體重下降），首先前往家庭醫生或普通科門診（GOPC）進行初步評估，並要求轉介至言語治療或相關專科。" : "If you notice dysphagia symptoms (coughing during meals, food or liquid entering the nose, unexplained weight loss), begin with your family doctor or a GOPC. Ask for a referral to speech therapy or to a relevant specialist clinic." },
    { "@type": "HowToStep", "position": 2, "name": lang === 'zh-hk' ? "如為急性症狀，直接前往急症室" : "Go directly to A&E if symptoms are acute", "text": lang === 'zh-hk' ? "若吞嚥困難突然出現或迅速惡化（如中風後、誤吸後），應直接前往最近急症室。急症入院後可由住院醫生直接轉介病房言語治療師，通常在數日內可獲評估。" : "If dysphagia is sudden or rapidly worsening (e.g., after a stroke or aspiration event), go directly to the nearest Accident and Emergency department. An inpatient admission allows the attending doctor to refer directly to the ward SLP — typically assessed within days." },
    { "@type": "HowToStep", "position": 3, "name": lang === 'zh-hk' ? "申請老人科日間醫院服務（如適用）" : "Request Geriatric Day Hospital referral if eligible", "text": lang === 'zh-hk' ? "65 歲以上長者患者可要求轉介至老人科日間醫院，提供包括言語治療在內的多專科評估，等候時間通常較一般專科門診短，且提供跨專科一站式服務。" : "Elderly patients aged 65+ can request referral to a Geriatric Day Hospital, which provides multidisciplinary assessment including speech therapy. Waiting times are typically shorter than general specialist outpatient clinics, with same-day cross-disciplinary review." },
    { "@type": "HowToStep", "position": 4, "name": lang === 'zh-hk' ? "在等候公立服務期間考慮私家言語治療" : "Consider private speech therapy while awaiting public services", "text": lang === 'zh-hk' ? "如公立等候時間過長而影響患者安全，可參考香港言語治療師公會（HKSLTA）名冊（hkslta.org.hk）聯絡私家言語治療師。私家首次評估通常可在數日至數週內安排。" : "If the public waiting period is long and the patient's safety is at risk, use the HKSLTA directory at hkslta.org.hk to identify a qualified private SLP. Initial private assessments are typically available within days to weeks." },
    { "@type": "HowToStep", "position": 5, "name": lang === 'zh-hk' ? "出院前確保獲得書面飲食建議書及後續預約" : "Secure a written Diet Prescription and follow-up appointment before discharge", "text": lang === 'zh-hk' ? "若患者曾住院接受言語治療評估，在出院前務必向言語治療師索取書面吞嚥困難飲食建議書，並確認已獲門診或老人科日間醫院的跟進預約。不應在無書面建議書的情況下離院。" : "If the patient was assessed by an inpatient SLP, do not leave hospital without a written Dysphagia Diet Prescription and a confirmed outpatient or Geriatric Day Hospital follow-up appointment. These two documents are essential for safe continuity of care at home." }
  ]
} : null;

const howToSchema = howToSchemaIddsi ?? howToSchemaDischarge ?? howToSchemaProfessionals ?? howToSchemaTubeTransition ?? howToSchemaCareHome ?? howToSchemaSpeechReferral ?? null;

// BreadcrumbList schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "inLanguage": lang === 'zh-hk' ? 'zh-HK' : 'en',
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": lang === 'zh-hk' ? "主頁" : "Home", "item": `https://softmeal.org/${lang}/`},
    {"@type": "ListItem", "position": 2, "name": title, "item": `https://softmeal.org/${lang}/${slug}/`}
  ]
};

const schemas = [
  ...(articleSchema ? [articleSchema] : []),
  ...(faqSchema ? [faqSchema] : []),
  ...(howToSchema ? [howToSchema] : []),
  breadcrumbSchema,
];
---

<PageLayout
  title={title}
  description={description}
  lang={lang}
  hreflangPair={hreflang_pair}
  hreflangPairLang={hreflangPairLang}
  schemaJson={schemas}
>
  <Content />
</PageLayout>
