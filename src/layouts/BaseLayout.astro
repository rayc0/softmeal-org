---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  hreflangPair?: string;
  hreflangPairLang?: string;
  canonicalUrl?: string;
  schemaJson?: object[];
  ogImage?: string;
}

const {
  title,
  description,
  lang = 'zh-hk',
  hreflangPair,
  hreflangPairLang,
  canonicalUrl,
  schemaJson = [],
  ogImage,
} = Astro.props;

const htmlLang = lang === 'zh-hk' ? 'zh-HK' : 'en';
const siteUrl = 'https://softmeal.org';
const canonical = canonicalUrl || Astro.url.href;

const hreflangMap: Record<string, string> = {
  'zh-hk': 'zh-HK',
  'en': 'en',
};

// Organization JSON-LD — emitted on all pages
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#org`,
  "name": "softmeal.org",
  "alternateName": "愛聯社有限公司",
  "url": `${siteUrl}/`,
  "sameAs": [
    "https://seniordeli.com/",
    "https://kangleling.com/",
    "https://dysphagia.cn/"
  ]
};

// WebSite JSON-LD — emitted on all pages
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "name": "softmeal.org",
  "url": siteUrl,
  "potentialAction": {
    "@type": "SearchAction",
    "target": {"@type": "EntryPoint", "urlTemplate": `${siteUrl}/zh-hk/?q={search_term_string}`},
    "query-input": "required name=search_term_string"
  }
};

const allSchemas = [orgSchema, websiteSchema, ...schemaJson];
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />

    <!-- hreflang -->
    <link rel="alternate" hreflang={hreflangMap[lang]} href={canonical} />
    {hreflangPair && hreflangPairLang && (() => {
      // Normalise: "en/index" → "en/", "en/dysphagia" → "en/dysphagia/"
      const normalised = hreflangPair.replace(/\/index$/, '');
      const href = normalised.endsWith('/') ? `${siteUrl}/${normalised}` : `${siteUrl}/${normalised}/`;
      return <link rel="alternate" hreflang={hreflangMap[hreflangPairLang]} href={href} />;
    })()}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/zh-hk/`} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="softmeal.org" />
    <meta property="og:locale" content={htmlLang.replace('-', '_')} />

    <!-- og:image — default fallback (pages with custom ogImage prop override this) -->
    {ogImage ? (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    ) : (
      <>
        <meta property="og:image" content={`${siteUrl}/og-default.png`} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />
      </>
    )}
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage || `${siteUrl}/og-default.png`} />

    <!-- Google Search Console verification — replace [GOOGLE_VERIFICATION_TOKEN] with token from GSC -->
    <!-- <meta name="google-site-verification" content="[GOOGLE_VERIFICATION_TOKEN]" /> -->

    <!-- AI crawler explicit allows meta -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    <!-- Favicon placeholder -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
  </head>
  <body>
    <!-- App CTA banner — appears on all pages -->
    <div style="background: #2563EB; color: white; text-align: center; padding: 8px 16px; font-size: 14px;">
      {lang === 'zh-hk' ? (
        <>
          📱 免費下載 SeniorDeli 吞嚥健康 App →
          <a href="https://www.seniordeli.com/app" style="color: white; font-weight: bold; text-decoration: underline;">
            Download Free App →
          </a>
        </>
      ) : (
        <>
          📱 Free dysphagia health app →
          <a href="https://www.seniordeli.com/app" style="color: white; font-weight: bold; text-decoration: underline;">
            Download Free App →
          </a>
        </>
      )}
    </div>
    <slot />
  </body>
</html>
