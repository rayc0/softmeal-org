---
import '../styles/global.css';

interface HreflangEntry {
  /** BCP-47 language tag, e.g. "zh-HK", "en", "x-default" */
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  lang?: string;
  /** Full list of hreflang alternates (including self + x-default).
   *  When provided, replaces the old hreflangPair/hreflangPairLang props. */
  hreflangLinks?: HreflangEntry[];
  canonicalUrl?: string;
  schemaJson?: object[];
  ogImage?: string;
}

const {
  title,
  description,
  lang = 'zh-hk',
  hreflangLinks,
  canonicalUrl,
  schemaJson = [],
  ogImage,
} = Astro.props;

const htmlLang = lang === 'zh-hk' ? 'zh-HK' : 'en';
const siteUrl = 'https://softmeal.org';
const canonical = canonicalUrl || Astro.url.href;

// Organization (NGO) JSON-LD — emitted on all pages
const orgSchema = {
  "@context": "https://schema.org",
  "@type": ["Organization", "NGO"],
  "@id": `${siteUrl}/#org`,
  "name": "softmeal.org",
  "url": `${siteUrl}/`,
  "logo": `${siteUrl}/og-default.png`,
  "description": htmlLang === 'zh-HK'
    ? "香港首個免費照護食知識中心，為照顧者、院舍及醫療專業人員提供 IDDSI 指南、食譜及資源。獨立編輯，非商業。"
    : "Hong Kong's first free dysphagia and texture-modified food knowledge hub — IDDSI framework guides, recipes, and resources for caregivers, care homes, and healthcare professionals. Editorially independent, non-commercial.",
  "knowsAbout": [
    "Dysphagia", "IDDSI Framework", "Texture-modified diet", "Thickened fluids",
    "Aspiration pneumonia prevention", "Elderly nutrition", "Care home dietetics",
    "Speech and language therapy", "EAT-10 screening", "GUSS screening"
  ],
  "areaServed": [
    {"@type": "AdministrativeArea", "name": "Hong Kong"},
    {"@type": "AdministrativeArea", "name": "Greater Bay Area"}
  ],
  "sameAs": [
    "https://seniordeli.com/",
    "https://kangleling.com/",
    "https://dysphagia.cn/"
  ]
};

// WebSite JSON-LD — emitted on all pages, with SearchAction in current locale
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "name": "softmeal.org",
  "alternateName": htmlLang === 'zh-HK' ? "香港照護食知識中心" : "Soft Meal Hong Kong",
  "url": siteUrl,
  "inLanguage": ["zh-HK", "en"],
  "publisher": {"@id": `${siteUrl}/#org`},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {"@type": "EntryPoint", "urlTemplate": `${siteUrl}/${lang}/?q={search_term_string}`},
    "query-input": "required name=search_term_string"
  }
};

// Speakable — for voice assistants + AI engines. Targets common content selectors.
const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#speakable`,
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "h2", ".description", "main p:first-of-type"]
  },
  "url": canonical,
  "inLanguage": htmlLang
};

const allSchemas = [orgSchema, websiteSchema, speakableSchema, ...schemaJson];
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />

    <!-- hreflang: collection-driven, emits only locales that actually exist -->
    {hreflangLinks && hreflangLinks.map((entry) => (
      <link rel="alternate" hreflang={entry.hreflang} href={entry.href} />
    ))}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="softmeal.org" />
    <meta property="og:locale" content={htmlLang.replace('-', '_')} />

    <!-- og:image — default fallback (pages with custom ogImage prop override this) -->
    {ogImage ? (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    ) : (
      <>
        <meta property="og:image" content={`${siteUrl}/og-default.png`} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />
      </>
    )}
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage || `${siteUrl}/og-default.png`} />

    <!-- Google Search Console verification — replace [GOOGLE_VERIFICATION_TOKEN] with token from GSC -->
    <!-- <meta name="google-site-verification" content="[GOOGLE_VERIFICATION_TOKEN]" /> -->

    <!-- AI crawler explicit allows meta -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />

    <!-- Favicon placeholder -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
  </head>
  <body>
    <!-- App CTA banner — appears on all pages -->
    <div style="background: #2563EB; color: white; text-align: center; padding: 8px 16px; font-size: 14px;">
      {lang === 'zh-hk' ? (
        <>
          📱 免費下載 SeniorDeli 吞嚥健康 App →
          <a href="https://www.seniordeli.com/app" style="color: white; font-weight: bold; text-decoration: underline;">
            Download Free App →
          </a>
        </>
      ) : (
        <>
          📱 Free dysphagia health app →
          <a href="https://www.seniordeli.com/app" style="color: white; font-weight: bold; text-decoration: underline;">
            Download Free App →
          </a>
        </>
      )}
    </div>
    <slot />
  </body>
</html>
