---
// Self-hosted fonts via @fontsource (JS imports resolve node_modules; CSS @import cannot)
// English — small subsets only (~4KB total)
import '@fontsource/fraunces/700.css';
import '@fontsource/inter-tight/400.css';
// CJK single-weight subsets — tiny CSS; variable-font indexes removed (each was 100–130KB,
// causing 467KB CSS bloat across all routes; system fonts cover zh-HK/zh-CN/ja adequately).
import '@fontsource/noto-sans-sc/chinese-simplified-400.css';
import '@fontsource/noto-sans-jp/japanese-400.css';

import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/print.css';
import PersonSchema from '../components/PersonSchema.astro';

// Preload woff2 files for English (headline + body); CJK uses system fonts
import frauncesHeadUrl from '@fontsource/fraunces/files/fraunces-latin-700-normal.woff2?url';
import interTightBodyUrl from '@fontsource/inter-tight/files/inter-tight-latin-400-normal.woff2?url';
import notoSansSCBodyUrl from '@fontsource/noto-sans-sc/files/noto-sans-sc-chinese-simplified-400-normal.woff2?url';
import notoSansJPBodyUrl from '@fontsource/noto-sans-jp/files/noto-sans-jp-japanese-400-normal.woff2?url';

interface HreflangEntry {
  /** BCP-47 language tag, e.g. "zh-HK", "en", "x-default" */
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  lang?: string;
  /** Full list of hreflang alternates (including self + x-default).
   *  When provided, replaces the old hreflangPair/hreflangPairLang props. */
  hreflangLinks?: HreflangEntry[];
  canonicalUrl?: string;
  schemaJson?: object[];
  ogImage?: string;
  ogType?: string;
  /** ISO 8601 date string — used for article:published_time meta (Doubao / Chinese AI engines) */
  datePublished?: string;
  /** ISO 8601 date string — used for article:modified_time meta (Doubao / Chinese AI engines) */
  dateModified?: string;
  /** Per-page OG image: type = 'recipes' | 'pages', slug = content slug (zh-hk only) */
  ogImageType?: 'recipes' | 'pages';
  ogImageSlug?: string;
}

const {
  title,
  description,
  lang = 'zh-hk',
  hreflangLinks,
  canonicalUrl,
  schemaJson = [],
  ogImage,
  ogType = 'website',
  datePublished,
  dateModified,
  ogImageType,
  ogImageSlug,
} = Astro.props;

// CDO §8: No web fonts on /zh-cn/ until cacheability through mainland CDN is confirmed.
// Set to true only after verifying Cloudflare / CDN serves woff2 to mainland China without
// blocking or throttling (test with WebPageTest from Shanghai/Beijing node).
//
// Mirror option: fonts.bcdn.cn hosts Google Fonts-compatible subsets served from a mainland
// CDN (ICP-licensed). When enabling, swap notoSansSCBodyUrl below for a bcdn.cn URL, e.g.:
//   https://fonts.bcdn.cn/css2?family=Noto+Sans+SC:wght@400&display=swap
// Confirm current TOS and availability before shipping.
const ZHCN_WEBFONT_ENABLED = false;

// Resolve per-page OG image URL. Priority: explicit ogImage > per-page generated > default.
const siteUrl = 'https://softmeal.org';
const resolvedOgImage = ogImage
  ?? (ogImageType && ogImageSlug ? `${siteUrl}/og/${ogImageType}/${ogImageSlug}.png` : null)
  ?? `${siteUrl}/og-default.png`;

const htmlLangMap: Record<string, string> = { 'zh-hk': 'zh-HK', 'zh-cn': 'zh-CN', 'ja': 'ja', 'en': 'en' };
const htmlLang = htmlLangMap[lang] ?? 'zh-HK';
const canonical = canonicalUrl || Astro.url.href;

// OG locale codes use underscores — map from internal lang key
const ogLocaleMap: Record<string, string> = {
  'zh-hk': 'zh_HK',
  'zh-cn': 'zh_CN',
  'ja': 'ja_JP',
  'en': 'en_US',
};
const ogLocale = ogLocaleMap[lang] ?? 'zh_HK';
// All other locales become og:locale:alternate
const ogLocaleAlternates = Object.entries(ogLocaleMap)
  .filter(([k]) => k !== lang)
  .map(([, v]) => v);

// Organization (NGO) JSON-LD — emitted on all pages
const orgSchema = {
  "@context": "https://schema.org",
  "@type": ["Organization", "NGO"],
  "@id": `${siteUrl}/#org`,
  "name": "softmeal.org",
  "legalName": "Carewells Limited",
  // TODO: add taxID once Raymond confirms HK CR number (Companies Registry number for Carewells Limited)
  "url": `${siteUrl}/`,
  "logo": `${siteUrl}/og-default.png`,
  "description": htmlLang === 'zh-HK'
    ? "香港首個免費照護食知識中心，為照顧者、院舍及醫療專業人員提供 IDDSI 指南、食譜及資源。獨立編輯，非商業。"
    : "Hong Kong's first free dysphagia and texture-modified food knowledge hub — IDDSI framework guides, recipes, and resources for caregivers, care homes, and healthcare professionals. Editorially independent, non-commercial.",
  "founder": {
    "@type": "Person",
    "@id": "https://ycchau.com/#person",
    "name": "Raymond Chau",
    "alternateName": "周益俊"
  },
  "award": [
    "Future Food Asia Award — Champion (All-Asia, Singapore)",
    "Hong Kong Social Enterprise Challenge — Champion (Home Affairs Bureau × CUHK)"
  ],
  "knowsAbout": [
    "Dysphagia", "IDDSI Framework", "Texture-modified diet", "Thickened fluids",
    "Aspiration pneumonia prevention", "Elderly nutrition", "Care home dietetics",
    "Speech and language therapy", "EAT-10 screening", "GUSS screening"
  ],
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Hong Kong",
    "addressRegion": "Hong Kong",
    "addressCountry": "HK"
  },
  "areaServed": [
    {"@type": "AdministrativeArea", "name": "Hong Kong"},
    {"@type": "AdministrativeArea", "name": "Greater Bay Area"}
  ],
  "sameAs": [
    "https://seniordeli.com/",
    "https://kangleling.com/",
    "https://dysphagia.cn/",
    // TODO: replace with real Q-IDs after Raymond submits to Wikidata (see softmeal_domination/measurement/wikidata_items.md)
    // "https://www.wikidata.org/wiki/QXXXXXXX",  ← softmeal.org website item
    // "https://www.wikidata.org/wiki/QYYYYYYY"   ← Carewells Limited item
  ]
};

// WebSite JSON-LD — emitted on all pages, with SearchAction in current locale
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "name": "softmeal.org",
  "alternateName": htmlLang === 'zh-HK' ? "香港照護食知識中心" : "Soft Meal Hong Kong",
  "url": siteUrl,
  "inLanguage": ["zh-HK", "en"],
  "publisher": {"@id": `${siteUrl}/#org`},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {"@type": "EntryPoint", "urlTemplate": `${siteUrl}/${lang}/?q={search_term_string}`},
    "query-input": "required name=search_term_string"
  }
};

// Speakable — for voice assistants + AI engines. Targets common content selectors.
const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical}#speakable`,
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "#article-body p:first-of-type"]
  },
  "url": canonical,
  "inLanguage": htmlLang
};

const allSchemas = [orgSchema, websiteSchema, speakableSchema, ...schemaJson];
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <!-- No-flash dark mode: must run before any CSS to avoid FOUC.
         Reads localStorage['theme'] first, falls back to prefers-color-scheme. -->
    <script is:inline>
      (function () {
        var s = localStorage.getItem('theme');
        var t = s === 'dark' || s === 'light' ? s
              : window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="language" content={htmlLang} />

    <link rel="canonical" href={canonical} />

    <!-- hreflang: collection-driven, emits only locales that actually exist + x-default -->
    {hreflangLinks && hreflangLinks.map((entry) => (
      <link rel="alternate" hreflang={entry.hreflang} href={entry.href} />
    ))}
    {!hreflangLinks && <link rel="alternate" hreflang="x-default" href={`${siteUrl}/zh-hk/`} />}

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="softmeal.org" />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((alt) => (
      <meta property="og:locale:alternate" content={alt} />
    ))}

    <!-- og:image — per-page generated or default fallback -->
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Search Engine Verification (replace PLACEHOLDERs in GSC / Bing / Baidu dashboards) -->
    <meta name="google-site-verification" content="GSC_PLACEHOLDER_softmeal" />
    <meta name="msvalidate.01" content="BING_PLACEHOLDER_softmeal" />
    <meta name="baidu-site-verification" content="BAIDU_PLACEHOLDER_softmeal" />

    <!-- AI crawler explicit allows meta -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="googlebot-extended" content="index, follow" />
    <meta name="bingbot" content="index, follow" />

    <!-- Doubao / ByteDance AI crawler explicit allows -->
    <meta name="bytespider" content="index, follow" />
    <meta name="doubaobot" content="index, follow" />

    <!-- Chinese AI-specific metadata (zh-cn / zh-hk locale) -->
    {(lang === 'zh-cn' || lang === 'zh-hk') && (
      <>
        <meta name="application-name" content="softmeal.org 照护食知识平台" />
        <meta name="zh-keywords" content="吞咽困难,IDDSI,照护食,软餐,老年护理,质感改良,长者饮食" />
      </>
    )}

    <!-- Article timestamps — Doubao and Chinese AI engines use these for freshness scoring -->
    {datePublished && <meta property="article:published_time" content={datePublished} />}
    {dateModified && <meta property="article:modified_time" content={dateModified} />}
    {(!datePublished && !dateModified) && ogType === 'article' && (
      <meta property="article:published_time" content={new Date().toISOString().slice(0, 10)} />
    )}

    <!-- RSS / Atom feed auto-discovery -->
    <link rel="alternate" type="application/rss+xml" title="softmeal.org — English" href="/en/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="softmeal.org — 繁體中文" href="/zh-hk/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="softmeal.org — 简体中文" href="/zh-cn/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title="softmeal.org — 日本語" href="/ja/rss.xml" />
    <link rel="alternate" type="application/atom+xml" title="softmeal.org — English (Atom)" href="/en/atom.xml" />
    <link rel="alternate" type="application/atom+xml" title="softmeal.org — 繁體中文 (Atom)" href="/zh-hk/atom.xml" />
    <link rel="alternate" type="application/atom+xml" title="softmeal.org — 简体中文 (Atom)" href="/zh-cn/atom.xml" />
    <link rel="alternate" type="application/atom+xml" title="softmeal.org — 日本語 (Atom)" href="/ja/atom.xml" />

    <!-- AI discovery links -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="alternate" type="text/plain" title="LLM-readable summary" href="/llms.txt" />
    <link rel="alternate" type="application/json" title="AI agent manifest" href="/.well-known/agent.json" />

    <!-- Favicon & PWA -->
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="msapplication-TileImage" content="/mstile-150.png">
    <meta name="msapplication-TileColor" content="#0a1428">

    <!-- ===== Critical resource hints ===== -->
    <!-- Preload favicon (renders immediately on all pages) -->
    <link rel="preload" as="image" href="/favicon.svg" type="image/svg+xml" />
    <!-- Preload default OG image on homepage/root pages (social crawlers + LCP candidate) -->
    {(!ogImageType || !ogImageSlug) && (
      <link rel="preload" as="image" href="/og-default.png" />
    )}
    <!-- Preload EN headline + body fonts; CJK relies on system fonts (PingFang/Hiragino/Noto) -->
    {lang === 'en' && (
      <>
        <link rel="preload" as="font" type="font/woff2" href={frauncesHeadUrl} crossorigin="anonymous" />
        <link rel="preload" as="font" type="font/woff2" href={interTightBodyUrl} crossorigin="anonymous" />
      </>
    )}
    {lang === 'zh-cn' && ZHCN_WEBFONT_ENABLED && (
      <link rel="preload" as="font" type="font/woff2" href={notoSansSCBodyUrl} crossorigin="anonymous" />
    )}
    {/* zh-cn: system font stack until ZHCN_WEBFONT_ENABLED — Source Han Sans (思源黑体) locally
        installed on most mainland devices; Noto Sans SC as remote fallback only when flag is on */}
    {lang === 'zh-cn' && !ZHCN_WEBFONT_ENABLED && (
      <style>
        :root {
          --font-body-zhcn: 'Source Han Sans SC', 'Source Han Sans CN', 'PingFang SC',
                            'Microsoft YaHei', 'Hiragino Sans GB', sans-serif;
        }
        body { font-family: var(--font-body-zhcn); }
      </style>
    )}
    {lang === 'ja' && (
      <link rel="preload" as="font" type="font/woff2" href={notoSansJPBodyUrl} crossorigin="anonymous" />
    )}

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
    <!-- Clinical reviewer Person entity — stable @id target for MedicalWebPage reviewedBy -->
    <PersonSchema />

    <!-- Cloudflare Web Analytics -->
    <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "auto"}'></script>
    <!-- End Cloudflare Web Analytics -->
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />

    <!-- ===== Web Vitals reporter ===== -->
    <!-- Reports LCP, CLS, INP to console. Zero render-blocking: defer + module.
         Uses official web-vitals CDN (1 KB gzipped). Replace console.log with
         a beacon call (e.g. navigator.sendBeacon('/api/vitals', ...)) to collect. -->
    <script type="module">
      import { onLCP, onCLS, onINP, onFCP, onTTFB } from 'https://unpkg.com/web-vitals@4/dist/web-vitals.attribution.js?module';
      const report = (metric) => {
        // Log to console for local dev / staging review
        console.info(`[Web Vitals] ${metric.name}: ${Math.round(metric.value)}${metric.name === 'CLS' ? '' : 'ms'} (rating: ${metric.rating})`);
        // Uncomment to beacon to an analytics endpoint:
        // navigator.sendBeacon('/api/vitals', JSON.stringify(metric));
      };
      onLCP(report);
      onCLS(report);
      onINP(report);
      onFCP(report);
      onTTFB(report);
    </script>
  </body>
</html>
