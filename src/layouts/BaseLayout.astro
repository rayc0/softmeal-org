---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  hreflangPair?: string;
  hreflangPairLang?: string;
  canonicalUrl?: string;
  schemaJson?: object[];
  ogImage?: string;
  speakable?: boolean;
}

const {
  title,
  description,
  lang = 'zh-hk',
  hreflangPair,
  hreflangPairLang,
  canonicalUrl,
  schemaJson = [],
  ogImage,
  speakable = false,
} = Astro.props;

const htmlLangMap: Record<string, string> = { 'zh-hk': 'zh-HK', 'zh-cn': 'zh-CN', 'ja': 'ja', 'en': 'en' };
const htmlLang = htmlLangMap[lang] ?? 'zh-HK';
const siteUrl = 'https://softmeal.org';
const canonical = canonicalUrl || Astro.url.href;

const hreflangMap: Record<string, string> = {
  'zh-hk': 'zh-HK',
  'zh-cn': 'zh-CN',
  'ja': 'ja',
  'en': 'en',
};

// OG locale codes use underscores — map from internal lang key
const ogLocaleMap: Record<string, string> = {
  'zh-hk': 'zh_HK',
  'zh-cn': 'zh_CN',
  'ja': 'ja_JP',
  'en': 'en_US',
};
const ogLocale = ogLocaleMap[lang] ?? 'zh_HK';
// All other locales become og:locale:alternate
const ogLocaleAlternates = Object.entries(ogLocaleMap)
  .filter(([k]) => k !== lang)
  .map(([, v]) => v);

// Organization JSON-LD — emitted on all pages
const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}/#org`,
  "name": "softmeal.org",
  "alternateName": "香港照護食知識中心",
  "url": `${siteUrl}/`,
  "sameAs": [
    "https://seniordeli.com/",
    "https://kangleling.com/",
    "https://dysphagia.cn/"
  ]
};

// WebSite JSON-LD — emitted on all pages
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  "name": "softmeal.org",
  "url": siteUrl,
  "potentialAction": {
    "@type": "SearchAction",
    "target": {"@type": "EntryPoint", "urlTemplate": `${siteUrl}/zh-hk/?q={search_term_string}`},
    "query-input": "required name=search_term_string"
  }
};

// Speakable schema — emitted on article pages when speakable=true
const speakableSchema = speakable ? {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": canonical,
  "speakable": {
    "@type": "SpeakableSpecification",
    "cssSelector": ["h1", "h2", ".article-summary", "article p:first-of-type"]
  },
  "url": canonical
} : null;

const allSchemas = [orgSchema, websiteSchema, ...schemaJson, ...(speakableSchema ? [speakableSchema] : [])];
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="language" content={htmlLang} />

    <link rel="canonical" href={canonical} />

    <!-- hreflang — all 4 locales + x-default -->
    <!-- When hreflangPair provides a precise URL for a locale, it overrides the
         generic root-only fallback below to avoid duplicate hreflang entries. -->
    {(!hreflangPair || hreflangPairLang !== 'zh-hk') && (
      <link rel="alternate" hreflang="zh-HK" href={lang === 'zh-hk' ? canonical : `${siteUrl}/zh-hk/`} />
    )}
    {(!hreflangPair || hreflangPairLang !== 'zh-cn') && (
      <link rel="alternate" hreflang="zh-CN" href={lang === 'zh-cn' ? canonical : `${siteUrl}/zh-cn/`} />
    )}
    {(!hreflangPair || hreflangPairLang !== 'ja') && (
      <link rel="alternate" hreflang="ja" href={lang === 'ja' ? canonical : `${siteUrl}/ja/`} />
    )}
    {(!hreflangPair || hreflangPairLang !== 'en') && (
      <link rel="alternate" hreflang="en" href={lang === 'en' ? canonical : `${siteUrl}/en/`} />
    )}
    {hreflangPair && hreflangPairLang && (() => {
      // Normalise: "en/index" → "en/", "en/dysphagia" → "en/dysphagia/"
      const normalised = hreflangPair.replace(/\/index$/, '');
      const href = normalised.endsWith('/') ? `${siteUrl}/${normalised}` : `${siteUrl}/${normalised}/`;
      return <link rel="alternate" hreflang={hreflangMap[hreflangPairLang]} href={href} />;
    })()}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/zh-hk/`} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="softmeal.org" />
    <meta property="og:locale" content={ogLocale} />
    {ogLocaleAlternates.map((alt) => (
      <meta property="og:locale:alternate" content={alt} />
    ))}

    <!-- og:image — default fallback (pages with custom ogImage prop override this) -->
    {ogImage ? (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    ) : (
      <>
        <meta property="og:image" content={`${siteUrl}/og-default.png`} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />
      </>
    )}
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage || `${siteUrl}/og-default.png`} />

    <!-- Google Search Console verification — replace [GOOGLE_VERIFICATION_TOKEN] with token from GSC -->
    <!-- <meta name="google-site-verification" content="[GOOGLE_VERIFICATION_TOKEN]" /> -->

    <!-- AI crawler explicit allows meta -->
    <meta name="robots" content="index, follow" />
    <meta name="googlebot" content="index, follow" />
    <meta name="googlebot-extended" content="index, follow" />
    <meta name="bingbot" content="index, follow" />

    <!-- AI discovery links -->
    <link rel="manifest" href="/manifest.json" />
    <link rel="alternate" type="text/plain" title="LLM-readable summary" href="/llms.txt" />
    <link rel="alternate" type="application/json" title="AI agent manifest" href="/.well-known/agent.json" />

    <!-- Favicon placeholder -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(allSchemas)} />
  </head>
  <body>
    <slot />
  </body>
</html>
