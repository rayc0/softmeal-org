---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ArticleHeader from '../components/ArticleHeader.astro';
import StickyToc from '../components/StickyToc.astro';
import ReviewedByRail from '../components/ReviewedByRail.astro';
import CitationBlock from '../components/CitationBlock.astro';

interface HreflangEntry {
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  lang: string;
  hreflangLinks?: HreflangEntry[];
  canonicalUrl?: string;
  schemaJson?: object[];
  ogType?: string;
  datePublished?: string;
  dateModified?: string;
  ogImageType?: 'recipes' | 'pages';
  ogImageSlug?: string;
  /** When set, renders ArticleHeader (H1 + last-reviewed meta) before slot content. */
  articleLastReviewed?: string;
  /** Entity that reviewed the article. Defaults to editorial org. */
  articleReviewedBy?: string;
  /** Estimated reading time in minutes. */
  articleReadMins?: number;
  /** Slug of a named advisor in src/content/advisors/; omit for editorial-board fallback. */
  articleReviewerSlug?: string;
  /** ISO date YYYY-MM-DD — drives CitationBlock. Falls back to dateModified if omitted. */
  citationDateModified?: string;
}

// Speakable defaults to true — tells AI/voice assistants this content is authoritative
// Pass-through all props including datePublished/dateModified for Doubao meta tags
const props = { speakable: true as boolean, ...Astro.props };
const { articleLastReviewed, articleReviewedBy, articleReadMins, articleReviewerSlug, citationDateModified } = props;
const citationUrl = props.canonicalUrl ?? Astro.url.href;
---

<BaseLayout {...props}>
  <!-- Reading progress bar -->
  <div id="reading-progress" aria-hidden="true"></div>

  <Nav lang={props.lang} />

  <main id="main-content" class="max-w-5xl mx-auto px-4 py-8 sm:py-12 lg:flex lg:gap-10 lg:items-start">
    <StickyToc lang={props.lang} />
    <div id="article-body" class="min-w-0 flex-1">
      {articleLastReviewed && (
        <ArticleHeader
          title={props.title}
          lastReviewed={articleLastReviewed}
          reviewedBy={articleReviewedBy}
          readMins={articleReadMins}
          lang={props.lang}
        />
      )}
      <slot />
      {(citationDateModified ?? props.dateModified ?? props.datePublished) && (
        <CitationBlock
          title={props.title}
          url={citationUrl}
          dateModified={citationDateModified ?? props.dateModified ?? props.datePublished ?? ''}
          lang={props.lang}
        />
      )}
    </div>
    {articleLastReviewed && (
      <ReviewedByRail lang={props.lang} reviewerSlug={articleReviewerSlug} />
    )}
  </main>

  <Footer lang={props.lang} />
</BaseLayout>

<script>
  function initReadingProgress() {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;

    function updateProgress() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? Math.min(100, (scrollTop / docHeight) * 100) : 0;
      bar.style.width = pct + '%';
    }

    // Remove any previously registered listener (Astro SPA navigation re-runs this script;
    // storing the handler on bar avoids stacking duplicate scroll listeners).
    const win = window as Window & { _progressHandler?: () => void };
    if (win._progressHandler) {
      window.removeEventListener('scroll', win._progressHandler);
    }
    win._progressHandler = updateProgress;
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }

  initReadingProgress();
  document.addEventListener('astro:page-load', initReadingProgress);
</script>
