---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface HreflangEntry {
  hreflang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  lang: string;
  hreflangLinks?: HreflangEntry[];
  canonicalUrl?: string;
  schemaJson?: object[];
  ogType?: string;
  ogImageType?: 'recipes' | 'pages';
  ogImageSlug?: string;
}

// Speakable defaults to true — tells AI/voice assistants this content is authoritative
const props = { speakable: true as boolean, ...Astro.props };
---

<BaseLayout {...props}>
  <!-- Reading progress bar -->
  <div id="reading-progress" aria-hidden="true"></div>

  <Nav lang={props.lang} />

  <main class="max-w-4xl mx-auto px-4 py-8 sm:py-12">
    <slot />
  </main>

  <Footer lang={props.lang} />
</BaseLayout>

<script>
  const bar = document.getElementById('reading-progress');
  if (bar) {
    function updateProgress() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? Math.min(100, (scrollTop / docHeight) * 100) : 0;
      bar.style.width = pct + '%';
    }
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }
</script>
