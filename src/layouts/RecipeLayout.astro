---
import PageLayout from './PageLayout.astro';
import IddsiLevelBadge from '../components/IddsiLevelBadge.astro';

interface Props {
  title: string;
  description: string;
  lang: string;
  hreflangPair?: string;
  hreflangPairLang?: string;
  iddsiLevel: number;
  prepTimeMinutes: number;
  difficulty: string;
  mainIngredient: string;
  tags: string[];
  schemaJson?: object[];
}

const {
  title,
  description,
  lang,
  hreflangPair,
  hreflangPairLang,
  iddsiLevel,
  prepTimeMinutes,
  difficulty,
  mainIngredient,
  tags,
  schemaJson = [],
} = Astro.props;

const difficultyLabels: Record<string, Record<string, string>> = {
  'zh-hk': { easy: '簡單', medium: '中等', hard: '困難' },
  'zh-cn': { easy: '简单', medium: '中等', hard: '困难' },
  'ja':    { easy: '簡単', medium: '普通', hard: '難しい' },
  'en':    { easy: 'Easy', medium: 'Medium', hard: 'Hard' },
};
const prepLabels: Record<string, string> = { 'zh-hk': '準備時間', 'zh-cn': '准备时间', 'ja': '調理時間', 'en': 'Prep time' };
const diffLabels2: Record<string, string> = { 'zh-hk': '難度', 'zh-cn': '难度', 'ja': '難易度', 'en': 'Difficulty' };
const timeUnits: Record<string, string> = { 'zh-hk': '分鐘', 'zh-cn': '分钟', 'ja': '分', 'en': ' min' };
const warningTexts: Record<string, string> = {
  'zh-hk': '⚠️ 本食譜僅供參考。食物質感因廚師技術及食材而異。請由言語治療師評估後確認適合的 IDDSI 級別。',
  'zh-cn': '⚠️ 本食谱仅供参考。食物质感因厨师技术及食材而异。请由言语治疗师评估后确认适合的 IDDSI 级别。',
  'ja':    '⚠️ このレシピは参考情報です。食感は調理技術・食材により異なります。言語聴覚士によるIDDSIレベルの確認を受けてください。',
  'en':    '⚠️ This recipe is for reference only. Texture varies by technique and ingredients. A speech therapist should confirm the appropriate IDDSI level.',
};

const diffLabel = difficultyLabels[lang]?.[difficulty] ?? difficulty;
const timeLabel = `${prepTimeMinutes}${timeUnits[lang] ?? ' min'}`;
---

<PageLayout
  title={title}
  description={description}
  lang={lang}
  hreflangPair={hreflangPair}
  hreflangPairLang={hreflangPairLang}
  schemaJson={schemaJson}
>
  <div class="mb-4 flex flex-wrap gap-2 items-center">
    <IddsiLevelBadge level={iddsiLevel} />
    <span class="text-sm text-gray-600">
      {prepLabels[lang] ?? 'Prep time'}: {timeLabel}
    </span>
    <span class="text-sm text-gray-600">
      {diffLabels2[lang] ?? 'Difficulty'}: {diffLabel}
    </span>
  </div>

  <slot />

  <div class="mt-6 flex flex-wrap gap-2">
    {tags.map(tag => (
      <span class="bg-gray-100 text-gray-700 text-xs px-2 py-1 rounded">#{tag}</span>
    ))}
  </div>

  <div class="mt-8 p-4 bg-yellow-50 border border-yellow-200 rounded">
    <p class="text-sm text-yellow-800">
      {warningTexts[lang] ?? warningTexts['en']}
    </p>
  </div>
</PageLayout>
