---
import PageLayout from './PageLayout.astro';
import IddsiLevelBadge from '../components/IddsiLevelBadge.astro';

interface Props {
  title: string;
  description: string;
  lang: string;
  hreflangPair?: string;
  hreflangPairLang?: string;
  iddsiLevel: number;
  prepTimeMinutes: number;
  difficulty: string;
  mainIngredient: string;
  tags: string[];
  schemaJson?: object[];
}

const {
  title,
  description,
  lang,
  hreflangPair,
  hreflangPairLang,
  iddsiLevel,
  prepTimeMinutes,
  difficulty,
  mainIngredient,
  tags,
  schemaJson = [],
} = Astro.props;

type LangKey = 'zh-hk' | 'zh-cn' | 'ja' | 'en';
const l = lang as LangKey;

const difficultyLabels: Record<LangKey, Record<string, string>> = {
  'zh-hk': { easy: '簡單', medium: '中等', hard: '困難' },
  'zh-cn': { easy: '简单', medium: '中等', hard: '困难' },
  'ja':    { easy: '簡単', medium: '普通', hard: '難しい' },
  'en':    { easy: 'Easy', medium: 'Medium', hard: 'Hard' },
};
const prepLabels: Record<LangKey, string>  = { 'zh-hk': '準備時間', 'zh-cn': '准备时间', 'ja': '調理時間', 'en': 'Prep' };
const diffLabels: Record<LangKey, string>  = { 'zh-hk': '難度', 'zh-cn': '难度', 'ja': '難易度', 'en': 'Difficulty' };
const timeUnits: Record<LangKey, string>   = { 'zh-hk': ' 分鐘', 'zh-cn': ' 分钟', 'ja': ' 分', 'en': ' min' };
const ingredientLabels: Record<LangKey, string> = { 'zh-hk': '主要食材', 'zh-cn': '主要食材', 'ja': '主な食材', 'en': 'Main ingredient' };
const warningTexts: Record<LangKey, string> = {
  'zh-hk': '⚠️ 本食譜僅供參考。食物質感因廚師技術及食材而異。請由言語治療師評估後確認適合的 IDDSI 級別。',
  'zh-cn': '⚠️ 本食谱仅供参考。食物质感因厨师技术及食材而异。请由言语治疗师评估后确认适合的 IDDSI 级别。',
  'ja':    '⚠️ このレシピは参考情報です。食感は調理技術・食材により異なります。言語聴覚士によるIDDSIレベルの確認を受けてください。',
  'en':    '⚠️ This recipe is for reference only. Texture varies by technique and ingredients. A speech therapist should confirm the appropriate IDDSI level.',
};

// IDDSI level accent border color (matches official palette)
const iddsiAccents: Record<number, string> = {
  0: '#9B9B9B', 1: '#9B9B9B', 2: '#E91E8C', 3: '#FFD700',
  4: '#2E7D32', 5: '#E65100', 6: '#1565C0', 7: '#E65100',
};
const accentColor = iddsiAccents[iddsiLevel] ?? iddsiAccents[4];

const diffLabel = difficultyLabels[l]?.[difficulty] ?? difficulty;
const timeLabel = `${prepTimeMinutes}${timeUnits[l]}`;
---

<PageLayout
  title={title}
  description={description}
  lang={lang}
  hreflangPair={hreflangPair}
  hreflangPairLang={hreflangPairLang}
  schemaJson={schemaJson}
  speakable={true}
>
  <!-- Recipe header card with IDDSI accent border -->
  <div
    class="mb-8 rounded-xl bg-surface-2 border border-border shadow-card overflow-hidden"
    style={`border-left: 4px solid ${accentColor};`}
  >
    <div class="p-5 sm:p-6">
      <!-- IDDSI badge + meta row -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <IddsiLevelBadge level={iddsiLevel} lang={lang} />
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-500">
          <span>
            <span class="font-medium text-gray-700">{prepLabels[l]}:</span> {timeLabel}
          </span>
          <span>
            <span class="font-medium text-gray-700">{diffLabels[l]}:</span> {diffLabel}
          </span>
          <span>
            <span class="font-medium text-gray-700">{ingredientLabels[l]}:</span> {mainIngredient}
          </span>
        </div>
      </div>

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map(tag => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </div>
  </div>

  <!-- Recipe body (MDX content) -->
  <div class="prose-softmeal">
    <slot />
  </div>

  <!-- Warning -->
  <div class="callout-warning mt-8">
    {warningTexts[l]}
  </div>
</PageLayout>
